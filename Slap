CreateSection("VISUALS")

local statsLoop
CreateToggle("Show Player Stats", function(state)
    if state then
        statsLoop = RunService.RenderStepped:Connect(function()
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= player and p.Character and p.Character:FindFirstChild("Head") and p.Character:FindFirstChild("Humanoid") then
                    local head = p.Character.Head
                    local hum = p.Character.Humanoid
                    
                    local bg = head:FindFirstChild("LumaStats")
                    if not bg then
                        bg = Instance.new("BillboardGui")
                        bg.Name = "LumaStats"
                        bg.Size = UDim2.new(0, 100, 0, 40)
                        bg.StudsOffset = Vector3.new(0, 3, 0)
                        bg.AlwaysOnTop = true
                        bg.Parent = head
                        
                        local t = Instance.new("TextLabel", bg)
                        t.BackgroundTransparency = 1
                        t.Size = UDim2.fromScale(1, 1)
                        t.TextColor3 = Color3.new(1,1,1)
                        t.TextStrokeTransparency = 0
                        t.Font = Enum.Font.GothamBold
                        t.TextSize = 12
                        t.TextWrapped = false
                    end
                    
                    bg.TextLabel.Text = string.format("%s\nHP: %.0f", p.DisplayName, hum.Health)
                    bg.TextLabel.TextColor3 = Color3.fromHSV((hum.Health/hum.MaxHealth)*0.3, 1, 1)
                end
            end
        end)
    else
        if statsLoop then statsLoop:Disconnect() end
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character and p.Character:FindFirstChild("Head") and p.Character.Head:FindFirstChild("LumaStats") then
                p.Character.Head.LumaStats:Destroy()
            end
        end
    end
end)

