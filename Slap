-- // SCREEN CLAMP LOGIC (Prevents dragging off screen) //
local dragging, dragInput, dragStart, startPos

local function clampToScreen(position)
    local viewport = Workspace.CurrentCamera.ViewportSize
    local size = MainFrame.AbsoluteSize
    
    local x = math.clamp(position.X.Offset, 0, viewport.X - size.X)
    local y = math.clamp(position.Y.Offset, 0, viewport.Y - size.Y)
    
    return UDim2.new(position.X.Scale, x, position.Y.Scale, y)
end

MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

MainFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        local newPos = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        -- Apply Clamp
        MainFrame.Position = clampToScreen(newPos)
    end
end)

-- // TOGGLE CREATOR //
local function CreateToggle(text, callback)
    local ToggleBtn = Instance.new("TextButton")
    ToggleBtn.Size = UDim2.new(1, 0, 0, 36)
    ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
    ToggleBtn.Text = text
    ToggleBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
    ToggleBtn.Font = Enum.Font.GothamSemibold
    ToggleBtn.TextSize = 14
    ToggleBtn.AutoButtonColor = false
    ToggleBtn.Parent = Container
    
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 8)
    btnCorner.Parent = ToggleBtn
    
    local Indicator = Instance.new("Frame")
    Indicator.Size = UDim2.new(0, 4, 1, 0)
    Indicator.BackgroundColor3 = Color3.fromRGB(255, 60, 60)
    Indicator.Parent = ToggleBtn
    
    local indCorner = Instance.new("UICorner")
    indCorner.CornerRadius = UDim.new(0, 8)
    indCorner.Parent = Indicator

    local state = false

    ToggleBtn.MouseButton1Click:Connect(function()
        state = not state
        local targetColor = state and Color3.fromRGB(80, 200, 120) or Color3.fromRGB(255, 60, 60)
        TweenService:Create(Indicator, TweenInfo.new(0.2), {BackgroundColor3 = targetColor}):Play()
        ToggleBtn.TextColor3 = state and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(200, 200, 200)
        
        -- System Notification
        Notify(text .. (state and " Enabled" or " Disabled"), targetColor)
        task.spawn(function() callback(state) end)
    end)
end

-- // LOGIC HELPERS //
local function getNearbyTarget(radius)
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local closest, minDist = nil, radius
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local dist = (p.Character.HumanoidRootPart.Position - char.HumanoidRootPart.Position).Magnitude
            if dist < minDist then
                minDist = dist
                closest = p.Character
            end
        end
    end
    return closest
end

-- // TOGGLES //

-- 1. AUTO DODGE
local dodgeLoop
CreateToggle("Auto Dodge", function(state)
    if state then
        dodgeLoop = RunService.Heartbeat:Connect(function()
            local target = getNearbyTarget(SLAP_RANGE)
            if target then
                -- Check for Visual Indicators
                if target:FindFirstChild("AttackHighlight") or target:FindFirstChild("Highlight") then
                    local args = { buffer.fromstring("\002"), {} }
                    DodgeRemote:FireServer(unpack(args))
                    Notify("Dodged!", Color3.fromRGB(100, 150, 255))
                    task.wait(COOLDOWN) 
                end
            end
        end)
    else
        if dodgeLoop then dodgeLoop:Disconnect() end
    end
end)

-- 2. AUTO SLAP (Combat)
local slapLoop
CreateToggle("Auto Slap", function(state)
    if state then
        slapLoop = RunService.Heartbeat:Connect(function()
            local target = getNearbyTarget(SLAP_RANGE)
            if target and target:FindFirstChild("Humanoid") then
                local hum = target.Humanoid
                local state = hum:GetState()
                -- Check for Fainted/Ragdoll
                if state == Enum.HumanoidStateType.Physics or state == Enum.HumanoidStateType.Ragdoll or hum.PlatformStand then
                    local args = { buffer.fromstring("\000"), {} }
                    CombatRemote:FireServer(unpack(args))
                    Notify("Slapped!", Color3.fromRGB(255, 100, 100))
                    task.wait(COOLDOWN)
                end
            end
        end)
    else
        if slapLoop then slapLoop:Disconnect() end
    end
end)

-- 3. AUTO ABILITY
local abilityLoop
CreateToggle("Auto Ability", function(state)
    if state then
        abilityLoop = RunService.Heartbeat:Connect(function()
            local target = getNearbyTarget(SLAP_RANGE)
            if target then
                -- Check if enemy is holding a tool
                local tool = target:FindFirstChildOfClass("Tool")
                if tool then 
                    local args = { buffer.fromstring("\000\004\000swap"), {} }
                    AbilityRemote:FireServer(unpack(args))
                    Notify("Ability Used!", Color3.fromRGB(200, 100, 255))
                    task.wait(COOLDOWN)
                end
            end
        end)
    else
        if abilityLoop then abilityLoop:Disconnect() end
    end
end)

