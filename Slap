--[[ 
    LUMACORE MINI: SLAP EDITION
    --------------------------------------------------
    - Compact UI focused on Slap Battles.
    - Custom Remote Events integrated.
    - Auto Dodge: Fires ZAP \002 when Highlight detected.
    - Auto Slap: Fires Combat Remote when target faints.
    - Auto Action B: Fires ZAP \000 on proximity.
    --------------------------------------------------
]]

-- // SERVICES //
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local gui = Instance.new("ScreenGui")
gui.Name = "LumaCoreMini_Slap"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

-- // CONFIGURATION //
local SLAP_RANGE = 15 -- Studs distance to detect enemies
local COOLDOWN = 0.2  -- Debounce speed

-- // REMOTES //
-- Safely get remotes to prevent errors if game updates
local RS = ReplicatedStorage
local ZapRemote = RS:FindFirstChild("ZAP") and RS.ZAP:FindFirstChild("COMBAT_RELIABLE")
local CombatRemote = RS:FindFirstChild("Client") and RS.Client:FindFirstChild("Net") and RS.Client.Net:FindFirstChild("Combat")

if not ZapRemote or not CombatRemote then
    warn("LumaCore: Could not find one or more RemoteEvents. Check game updates.")
end

