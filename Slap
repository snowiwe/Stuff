local function Notify(text, color)
    local banner = Instance.new("Frame")
    banner.Size = UDim2.new(0, 200, 0, 30)
    banner.Position = UDim2.new(0.5, -100, 0.85, 0) -- Bottom Center
    banner.BackgroundColor3 = color or Color3.fromRGB(40, 40, 50)
    banner.Parent = NotifContainer
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = banner
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1,1)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(255,255,255)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 14
    label.Text = text
    label.Parent = banner
    
    -- Animation
    banner.BackgroundTransparency = 1
    label.TextTransparency = 1
    TweenService:Create(banner, TweenInfo.new(0.3), {BackgroundTransparency = 0}):Play()
    TweenService:Create(label, TweenInfo.new(0.3), {TextTransparency = 0}):Play()
    
    task.delay(1.5, function()
        TweenService:Create(banner, TweenInfo.new(0.5), {BackgroundTransparency = 1, Position = UDim2.new(0.5, -100, 0.85, -20)}):Play()
        TweenService:Create(label, TweenInfo.new(0.5), {TextTransparency = 1}):Play()
        task.wait(0.5)
        banner:Destroy()
    end)
end

