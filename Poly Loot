-- ANIMATION TOGGLE SUPPORT
local AnimationsEnabled = true
local function tw(obj, props, dur, style, dir)
    if not AnimationsEnabled then
        for prop, val in pairs(props) do
            pcall(function() obj[prop] = val end)
        end
        return {Completed = {Wait = function() end, Connect = function(_, fn) fn() end}}
    end
    local t = TweenService:Create(
        obj,
        TweenInfo.new(dur or 0.22, style or Enum.EasingStyle.Quart, dir or Enum.EasingDirection.Out),
        props
    )
    t:Play()
    return t
end

