        Instance.new("UICorner", toast).CornerRadius = UDim.new(0, 6)
        local s = Instance.new("UIStroke")
        s.Color = color or C.Accent
        s.Thickness = 1
        s.Parent = toast

        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.fromScale(1, 1)
        lbl.BackgroundTransparency = 1
        lbl.Text = text
        lbl.TextColor3 = C.Text
        lbl.Font = Enum.Font.GothamMedium
        lbl.TextSize = 11
        lbl.ZIndex = 2001
        lbl.Parent = toast

        tw(toast, {Position = UDim2.new(0.5, -100, 0.84, 0)}, 0.2)
        task.wait(2)
        tw(toast, {Position = UDim2.new(0.5, -100, 0.88, 0), BackgroundTransparency = 1}, 0.25)
        tw(lbl, {TextTransparency = 1}, 0.25)
        task.wait(0.25)
        toast:Destroy()
    end)
end

