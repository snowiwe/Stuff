-- 4. DYNAMIC REMOTES RESOLVER
local GhostSwingRemote = nil
local ResetRequestedRemote = nil
local DailyCheckInRemote = nil
local ShopBuyRemote = nil
local EquipRequestRemote = nil

local function resolveRemotes()
    pcall(function()
        local hEngine = ReplicatedStorage:FindFirstChild("Halloween_Engine")
        if hEngine then
            local remotes = hEngine:FindFirstChild("Remotes")
            if remotes then
                GhostSwingRemote = remotes:FindFirstChild("GhostSwing")
                DailyCheckInRemote = remotes:FindFirstChild("DailyCheckIn")
                ShopBuyRemote = remotes:FindFirstChild("Buy") 
                    or remotes:FindFirstChild("AttemptBuy") 
                    or remotes:FindFirstChild("Purchase") 
                    or remotes:FindFirstChild("ShopBuy")
            end
        end
        if not GhostSwingRemote then GhostSwingRemote = ReplicatedStorage:FindFirstChild("GhostSwing", true) end
        if not DailyCheckInRemote then DailyCheckInRemote = ReplicatedStorage:FindFirstChild("DailyCheckIn", true) end
        if not ShopBuyRemote then 
            ShopBuyRemote = ReplicatedStorage:FindFirstChild("Buy", true) 
                or ReplicatedStorage:FindFirstChild("Purchase", true) 
        end
    end)

    pcall(function()
        local dEngine = ReplicatedStorage:FindFirstChild("Death_Engine")
        if dEngine then
            local remotes = dEngine:FindFirstChild("Remotes")
            if remotes then
                ResetRequestedRemote = remotes:FindFirstChild("ResetRequested")
            end
        end
        if not ResetRequestedRemote then ResetRequestedRemote = ReplicatedStorage:FindFirstChild("ResetRequested", true) end
    end)

    pcall(function()
        local invEngine = ReplicatedStorage:FindFirstChild("Inventory_Engine")
        if invEngine then
            local remotes = invEngine:FindFirstChild("Remotes")
            if remotes then
                EquipRequestRemote = remotes:FindFirstChild("EquipRequest")
            end
        end
        if not EquipRequestRemote then
            EquipRequestRemote = ReplicatedStorage:FindFirstChild("EquipRequest", true)
        end
    end)
end
task.spawn(resolveRemotes)

