-- SMOOTH CANDY CORN FARM WORKER THREAD (CONTROLLED PACING + GROUND-SAFE INSIDE TARGETING)
task.spawn(function()
    while true do
        if autoCandyFarm and not waitingForModeChoice then
            ensureGhostNetEquipped()
            local ghost, ghostPart = getNearestGhost()
            currentTargetGhost = ghost

            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")

            if ghost and ghostPart and ghost.Parent and hrp and hum then
                if aiChaseActive then
                    restoreSurface()
                    local myPos = hrp.Position
                    local targetPos = ghostPart.Position
                    local dist = (Vector2.new(targetPos.X, targetPos.Z) - Vector2.new(myPos.X, myPos.Z)).Magnitude

                    hum:MoveTo(targetPos)

                    local rayParams = RaycastParams.new()
                    rayParams.FilterDescendantsInstances = {char}
                    local rayHit = Workspace:Raycast(myPos, (targetPos - myPos).Unit * 4.5, rayParams)
                    if (rayHit and rayHit.Instance and rayHit.Instance.CanCollide) or (targetPos.Y > myPos.Y + 2.5) then
                        hum.Jump = true
                    end

                    if dist <= 9.0 then
                        if catchDelay > 0 then task.wait(catchDelay) end
                        executeGhostSwing(ghost)
                    end
                    task.wait(0.05)
                else
                    local targetGoalCF
                    if farmStance == "Underground" then
                        isUnderground = true
                        targetGoalCF = ghostPart.CFrame * CFrame.new(0, -6.5, 0)
                    else
                        if isUnderground then restoreSurface() end
                        
                        -- Raycast floor verification to never sink or clip under ground geometry
                        local ghostPos = ghostPart.Position
                        local floorRayParams = RaycastParams.new()
                        floorRayParams.FilterDescendantsInstances = {char, ghost, locateGhostFolder()}
                        local floorHit = Workspace:Raycast(ghostPos + Vector3.new(0, 4, 0), Vector3.new(0, -18, 0), floorRayParams)
                        
                        local safeCenterPos = ghostPos
                        if floorHit then
                            local groundMinY = floorHit.Position.Y + 3.0 -- Maintain minimum clearance above surface
                            if safeCenterPos.Y < groundMinY then
                                safeCenterPos = Vector3.new(safeCenterPos.X, groundMinY, safeCenterPos.Z)
                            end
                        end
                        
                        -- Position inside the ghost with its orientation
                        targetGoalCF = CFrame.new(safeCenterPos) * (ghostPart.CFrame - ghostPart.Position)
                    end

                    local startCF = hrp.CFrame
                    local distanceToGoal = (startCF.Position - targetGoalCF.Position).Magnitude
                    
                    if distanceToGoal > 40 then
                        -- Safe long-range boundary teleport
                        hrp.CFrame = targetGoalCF
                        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                    else
                        -- Smoothed, controlled travel pace
                        local steps = math.clamp(math.floor(distanceToGoal / 1.4), 8, 22)
                        for i = 1, steps do
                            if not autoCandyFarm or not ghost.Parent then break end
                            local t = i / steps
                            local smoothAlpha = t * t * (3 - 2 * t) -- Smoothstep curve
                            hrp.CFrame = startCF:Lerp(targetGoalCF, smoothAlpha)
                            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                            hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                            RunService.Heartbeat:Wait()
                        end
                    end

                    -- Configurable Catch Delay buffer
                    if catchDelay > 0 then
                        task.wait(catchDelay)
                    end

                    if ghost.Parent then
                        executeGhostSwing(ghost)
                    end
                    task.wait(0.06)
                end
            else
                restoreSurface()
                task.wait(0.18)
            end
        else
            restoreSurface()
            task.wait(0.25)
        end
    end
end)

