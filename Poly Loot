local isOpen = false
local function openMenu()
    isOpen = true
    ScreenGui.Enabled = true
    Backdrop.Visible = true

    Card.Position = UDim2.new(0.5, 0, 0.54, 0)
    Card.Size = UDim2.new(0, 500, 0, 280)
    Card.Rotation = -10
    Card.BackgroundTransparency = 0.4

