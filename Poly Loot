-- 11. GHOST DISCOVERY ENGINE
local function locateGhostFolder()
    local folder = Workspace:FindFirstChild("Halloween_Ghosts") or ReplicatedStorage:FindFirstChild("Halloween_Ghosts")
    if folder then return folder end
    for _, child in ipairs(Workspace:GetChildren()) do
        if string.find(string.lower(child.Name), "ghost") and (child:IsA("Folder") or child:IsA("Model")) then
            return child
        end
    end
    return nil
end

local function getNearestGhost()
    local folder = locateGhostFolder()
    if not folder then return nil, nil end

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local myPos = hrp and hrp.Position or Vector3.new(0, 0, 0)

    local nearestGhost, nearestPart = nil, nil
    local minDistance = math.huge

    for _, ghost in ipairs(folder:GetChildren()) do
        local hum = ghost:FindFirstChildOfClass("Humanoid")
        local isDead = hum and hum.Health <= 0
        if not isDead then
            local part = ghost:IsA("BasePart") and ghost
                or ghost.PrimaryPart
                or ghost:FindFirstChildWhichIsA("BasePart", true)

            if part then
                local dist = (part.Position - myPos).Magnitude
                if dist < minDistance then
                    minDistance = dist
                    nearestGhost = ghost
                    nearestPart = part
                end
            end
        end
    end
    return nearestGhost, nearestPart
end

-- 12. GHOST NET EQUIP & UNEQUIP ENGINES
local hasEquippedNetOnce = false

local function ensureGhostNetEquipped()
    local char = LocalPlayer.Character
    if not char then return end

    local function isNet(item)
        if not item or not item:IsA("Tool") then return false end
        local name = string.lower(item.Name)
        return string.find(name, "net") or item:GetAttribute("NET_ITEM") ~= nil
    end

    if isNet(char:FindFirstChildWhichIsA("Tool")) then
        hasEquippedNetOnce = true
        return
    end

    if not hasEquippedNetOnce then
        resolveRemotes()
        if EquipRequestRemote then
            pcall(function() EquipRequestRemote:FireServer("s_1600e36b_4") end)
        end
        for _, item in ipairs(LocalPlayer.Backpack:GetChildren()) do
            if isNet(item) then
                item.Parent = char
                hasEquippedNetOnce = true
                break
            end
        end
    end
end

local function unequipGhostNet()
    hasEquippedNetOnce = false
    local char = LocalPlayer.Character
    if not char then return end
    for _, item in ipairs(char:GetChildren()) do
        if item:IsA("Tool") and (string.find(string.lower(item.Name), "net") or item:GetAttribute("NET_ITEM")) then
            item.Parent = LocalPlayer.Backpack
        end
    end
end

