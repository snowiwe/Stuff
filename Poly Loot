    tw(Card, {
        Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = UDim2.new(0, 580, 0, 340),
        Rotation = 0,
        BackgroundTransparency = 0
    }, 0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
end

local function closeMenu()
    isOpen = false
    tw(Backdrop, {BackgroundTransparency = 1}, 0.2)
    local t = tw(Card, {
        Position = UDim2.new(0.5, 0, 0.53, 0),
        Size = UDim2.new(0, 500, 0, 280),
        Rotation = 8,
        BackgroundTransparency = 1
    }, 0.24, Enum.EasingStyle.Quart, Enum.EasingDirection.In)

    t.Completed:Connect(function()
        if not isOpen then
            Backdrop.Visible = false
            Card.Rotation = 0
        end
    end)
end

CloseBtn.MouseButton1Click:Connect(closeMenu)
Backdrop.MouseButton1Click:Connect(closeMenu)

UserInputService.InputBegan:Connect(function(input, gpe)
    if not gpe and input.KeyCode == Enum.KeyCode.RightControl then
        if isOpen then closeMenu() else openMenu() end
    end
end)

