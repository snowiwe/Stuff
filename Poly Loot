local function Notify(text, color)
    if not NotificationsEnabled then return end
    task.spawn(function()
        local toast = Instance.new("Frame")
        toast.Size = UDim2.new(0, 200, 0, 32)
        toast.Position = UDim2.new(0.5, -100, 0.88, 0)
