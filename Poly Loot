-- 10. OPTIMIZED CANDY CORN / GHOST AUTO-FARM ENGINE
local autoCandyFarm = false
local isUnderground = false
local GhostSwingRemote = nil
local CurrentTargetGhost = nil
local GhostContainer = nil

task.spawn(function()
    pcall(function()
        local hEngine = ReplicatedStorage:WaitForChild("Halloween_Engine", 4)
        if hEngine then
            local remotes = hEngine:WaitForChild("Remotes", 4)
            if remotes then
                GhostSwingRemote = remotes:WaitForChild("GhostSwing", 3)
            end
        end
    end)
end)

local function locateGhostFolder()
    if GhostContainer and GhostContainer.Parent then return GhostContainer end
    GhostContainer = Workspace:FindFirstChild("Halloween_Ghosts") or ReplicatedStorage:FindFirstChild("Halloween_Ghosts")
    return GhostContainer
end

local function getNearestGhost()
    local folder = locateGhostFolder()
    if not folder then return nil, nil end

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local myPos = hrp and hrp.Position or Vector3.new(0, 0, 0)

    local nearestGhost, nearestPart = nil, nil
    local minDistance = math.huge

    for _, ghost in ipairs(folder:GetChildren()) do
        local part = ghost:IsA("BasePart") and ghost
            or ghost.PrimaryPart
            or ghost:FindFirstChildWhichIsA("BasePart", true)

        if part then
            local dist = (part.Position - myPos).Magnitude
            if dist < minDistance then
                minDistance = dist
                nearestGhost = ghost
                nearestPart = part
            end
        end
    end
    return nearestGhost, nearestPart
end

-- Instant target clearing hook
task.spawn(function()
    while true do
        local folder = locateGhostFolder()
        if folder then
            folder.ChildRemoved:Connect(function(child)
                if CurrentTargetGhost and child == CurrentTargetGhost then
                    CurrentTargetGhost = nil
                end
            end)
            break
        end
        task.wait(1)
    end
end)

-- Underground physics clamp
RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    if char and isUnderground then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end

        local hrp = char:FindFirstChild("HumanoidRootPart")
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if hrp and humanoid then
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            humanoid:ChangeState(Enum.HumanoidStateType.Physics)
        end
    end
end)

-- Main farm routine
task.spawn(function()
    while true do
        if autoCandyFarm then
            local ghost, ghostPart = getNearestGhost()
            CurrentTargetGhost = ghost
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local humanoid = char and char:FindFirstChildOfClass("Humanoid")

            if ghost and ghostPart then
                isUnderground = true
                if hrp then
                    hrp.CFrame = ghostPart.CFrame * CFrame.new(0, -7, 0)
                end

                task.wait(0.04)
                if GhostSwingRemote and ghost.Parent then
                    pcall(function()
                        GhostSwingRemote:FireServer(ghost.Name)
                    end)
                end
            else
                if isUnderground then
                    isUnderground = false
                    if hrp and humanoid then
                        humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
                        hrp.CFrame = hrp.CFrame + Vector3.new(0, 8, 0)
                        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    end
                end
            end
        else
            if isUnderground then
                isUnderground = false
                local char = LocalPlayer.Character
                local humanoid = char and char:FindFirstChildOfClass("Humanoid")
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if humanoid and hrp then
                    humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
                    hrp.CFrame = hrp.CFrame + Vector3.new(0, 8, 0)
                    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                end
            end
        end
        task.wait(0.12)
    end
end)

