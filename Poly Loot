local function locateGhostFolder()
    return Workspace:FindFirstChild("Halloween_Ghosts") or ReplicatedStorage:FindFirstChild("Halloween_Ghosts")
end

local function getNearestGhost()
    local folder = locateGhostFolder()
    if not folder then return nil, nil end

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local myPos = hrp and hrp.Position or Vector3.new(0, 0, 0)

    local nearestGhost, nearestPart = nil, nil
    local minDistance = math.huge

    for _, ghost in ipairs(folder:GetChildren()) do
        local hum = ghost:FindFirstChildOfClass("Humanoid")
        local isDead = hum and hum.Health <= 0
        if not isDead then
            local part = ghost:IsA("BasePart") and ghost
                or ghost.PrimaryPart
                or ghost:FindFirstChildWhichIsA("BasePart", true)

            if part then
                local dist = (part.Position - myPos).Magnitude
                if dist < minDistance then
                    minDistance = dist
                    nearestGhost = ghost
                    nearestPart = part
                end
            end
        end
    end
    return nearestGhost, nearestPart
end

