local function resolveTargetIds(maxRadius)
    local char = LocalPlayer.Character
    if not (char and char:FindFirstChild("HumanoidRootPart")) then return {-1006, -1011} end
    local pPos = char.HumanoidRootPart.Position
    local ids = {}

    for _, model in ipairs(Workspace:GetDescendants()) do
        if model:IsA("Model") and model ~= char then
            local hum = model:FindFirstChildOfClass("Humanoid")
            local root = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChildWhichIsA("BasePart")
            if hum and hum.Health > 0 and root and not Players:GetPlayerFromCharacter(model) then
                local dist = (root.Position - pPos).Magnitude
                if dist <= (maxRadius or 25) then
                    local idAttr = model:GetAttribute("Id") or model:GetAttribute("targetId") or model:GetAttribute("ID")
                    if idAttr then
                        table.insert(ids, idAttr)
                    else
                        local idChild = model:FindFirstChild("Id") or model:FindFirstChild("targetId")
                        if idChild and idChild:IsA("ValueBase") then
                            table.insert(ids, idChild.Value)
                        end
                    end
                end
            end
        end
    end

    if #ids == 0 then ids = {-1006, -1011} end
    return ids
end

local lastTackleTick = 0
local function executeTackle()
    if not HitReplayEvent then return end
    if tick() - lastTackleTick < 0.18 then return end
    lastTackleTick = tick()

    task.spawn(function()
        local char = LocalPlayer.Character
        if not (char and char:FindFirstChild("HumanoidRootPart")) then return end

        local now = os.time()
        local attackUuid = HttpService:GenerateGUID(false)
        local targetList = resolveTargetIds(25)
        local lookDir = char.HumanoidRootPart.CFrame.LookVector

        local attackData = {
            ["manual"] = true,
            ["direction"] = lookDir,
            ["id"] = attackUuid,
            ["targets"] = {},
            ["box"] = {["height"] = 16, ["far"] = 26, ["near"] = 0, ["width"] = 28},
            ["character"] = char,
            ["startedAt"] = now,
            ["ends"] = now + 0.45,
            ["starts"] = now,
            ["kind"] = "Tackle",
            ["canonicalId"] = attackUuid,
            ["targetIds"] = targetList
        }

        pcall(function()
            HitReplayEvent:FireServer("Attack", attackData)
        end)

        for _, tid in ipairs(targetList) do
            local verdictData = {
                ["source"] = "Server",
                ["targetId"] = tid,
                ["id"] = HttpService:GenerateGUID(false),
                ["kind"] = "Tackle",
                ["reason"] = "resolved",
                ["accepted"] = true
            }
            pcall(function()
                HitReplayEvent:FireServer("Verdict", verdictData)
            end)
        end
    end)
end

