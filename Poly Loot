-- 18. SAFE CLAMPING & DRAGGING
local function clampPosition(rawPos, obj)
    local cam = Workspace.CurrentCamera
    local vSize = (cam and cam.ViewportSize) or Vector2.new(800, 600)
    if vSize.X <= 50 or vSize.Y <= 50 then return rawPos end

    local oWidth = (obj.AbsoluteSize.X > 0 and obj.AbsoluteSize.X) or 580
    local oHeight = (obj.AbsoluteSize.Y > 0 and obj.AbsoluteSize.Y) or 345
    local pad = 6

    local absX = (rawPos.X.Scale * vSize.X) + rawPos.X.Offset
    local absY = (rawPos.Y.Scale * vSize.Y) + rawPos.Y.Offset

    local minX = (obj.AnchorPoint.X * oWidth) + pad
    local maxX = vSize.X - ((1 - obj.AnchorPoint.X) * oWidth) - pad
    local minY = (obj.AnchorPoint.Y * oHeight) + pad
    local maxY = vSize.Y - ((1 - obj.AnchorPoint.Y) * oHeight) - pad

    return UDim2.new(0, math.clamp(absX, minX, maxX), 0, math.clamp(absY, minY, maxY))
end

local dragging = false
local dragStart = nil
local startPos = nil

Header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = Card.Position

        local moveConn, endConn
        moveConn = UserInputService.InputChanged:Connect(function(moveInput)
            if (moveInput.UserInputType == Enum.UserInputType.MouseMovement or moveInput.UserInputType == Enum.UserInputType.Touch) and dragging then
                local delta = moveInput.Position - dragStart
                local raw = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
                Card.Position = clampPosition(raw, Card)
            end
        end)

        endConn = UserInputService.InputEnded:Connect(function(endInput)
            if endInput.UserInputType == Enum.UserInputType.MouseButton1 or endInput.UserInputType == Enum.UserInputType.Touch then
                dragging = false
                if moveConn then moveConn:Disconnect() end
                if endConn then endConn:Disconnect() end
            end
        end)
    end
end)

-- 19. ENTRANCE & INTRO LOADER
local isTransitioning = false
local isOpen = false

local function openMenu()
    if isTransitioning or isOpen then return end
    isTransitioning = true

    if MobileToggle and MobileToggle.Visible and AnimationsEnabled then
        tw(MobileToggle, {Size = UDim2.new(0, 32, 0, 32), Rotation = 20}, 0.1, Enum.EasingStyle.Quart)
        task.delay(0.1, function()
            tw(MobileToggle, {Size = UDim2.new(0, 38, 0, 38), Rotation = 0}, 0.18, Enum.EasingStyle.Back)
        end)
    end

    Backdrop.Visible = true
    Backdrop.BackgroundTransparency = 1
    tw(Backdrop, {BackgroundTransparency = 0.5}, 0.2)

    if AnimationsEnabled then
        LoaderPill.Visible = true
        LoaderPill.BackgroundTransparency = 0.4
        Spinner.Rotation = 0
        local spinTween = TweenService:Create(Spinner, TweenInfo.new(0.6, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1), {Rotation = 360})
        spinTween:Play()
        task.wait(0.2)
        spinTween:Cancel()
        LoaderPill.Visible = false
    end

    isOpen = true
    Card.Visible = true

    if AnimationsEnabled then
        Card.Position = UDim2.new(0.5, 0, 0.54, 0)
        Card.Size = UDim2.new(0, 520, 0, 290)
        Card.Rotation = -8
        Card.BackgroundTransparency = 0.4

        local openAnim = tw(Card, {
            Position = UDim2.new(0.5, 0, 0.5, 0),
            Size = UDim2.new(0, 580, 0, 345),
            Rotation = 0,
            BackgroundTransparency = 0
        }, 0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

        openAnim.Completed:Connect(function()
            isTransitioning = false
        end)
    else
        Card.Position = UDim2.new(0.5, 0, 0.5, 0)
        Card.Size = UDim2.new(0, 580, 0, 345)
        Card.Rotation = 0
        Card.BackgroundTransparency = 0
        isTransitioning = false
    end
end

local function closeMenu()
    if isTransitioning or not isOpen then return end
    isTransitioning = true
    isOpen = false

    if AnimationsEnabled then
        tw(Backdrop, {BackgroundTransparency = 1}, 0.2)
        local closeAnim = tw(Card, {
            Position = UDim2.new(0.5, 0, 0.53, 0),
            Size = UDim2.new(0, 500, 0, 280),
            Rotation = 6,
            BackgroundTransparency = 1
        }, 0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.In)

        closeAnim.Completed:Connect(function()
            Backdrop.Visible = false
            Card.Visible = false
            Card.Rotation = 0
            isTransitioning = false
        end)
    else
        Backdrop.Visible = false
        Card.Visible = false
        isTransitioning = false
    end
end

