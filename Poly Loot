local HitReplayEvent
task.spawn(function()
    pcall(function()
        local ch = ReplicatedStorage:WaitForChild("ChickenOrHero", 4)
        if ch then
            local g = ch:WaitForChild("Game", 4)
            if g then HitReplayEvent = g:WaitForChild("HitReplayEvent", 3) end
        end
    end)
end)

local AuraHitboxActive = false
local AuraBoxPart = nil
local AuraBoxConn = nil

local function cleanupAura()
    if AuraBoxConn then AuraBoxConn:Disconnect(); AuraBoxConn = nil end
    if AuraBoxPart then AuraBoxPart:Destroy(); AuraBoxPart = nil end
end

local function executeTackle()
    if not HitReplayEvent then return end
    local char = LocalPlayer.Character
    if not (char and char:FindFirstChild("HumanoidRootPart")) then return end

    local now = os.time()
    local attackUuid = HttpService:GenerateGUID(false)
    local lookDir = char.HumanoidRootPart.CFrame.LookVector

    local attackData = {
        ["manual"] = true,
        ["direction"] = lookDir,
        ["id"] = attackUuid,
        ["targets"] = {},
        ["box"] = {["height"] = 16, ["far"] = 26, ["near"] = 0, ["width"] = 28},
        ["character"] = char,
        ["startedAt"] = now,
        ["ends"] = now + 0.45,
        ["starts"] = now,
        ["kind"] = "Tackle",
        ["canonicalId"] = attackUuid,
        ["targetIds"] = {-1006, -1011}
    }

    pcall(function()
        HitReplayEvent:FireServer("Attack", attackData)
    end)
end

local function setupAuraHitbox()
    cleanupAura()
    AuraBoxPart = Instance.new("Part")
    AuraBoxPart.Name = "PolyLoot_SquaredHitbox"
    AuraBoxPart.Anchored = true
    AuraBoxPart.CanCollide = false
    AuraBoxPart.CanTouch = false
    AuraBoxPart.Transparency = 0.72
    AuraBoxPart.Material = Enum.Material.Neon
    AuraBoxPart.Color = HitboxColors[CurrentColorIndex].color
    AuraBoxPart.Shape = Enum.PartType.Block
    AuraBoxPart.Size = Vector3.new(16, 6, 16)
    AuraBoxPart.Parent = Workspace

    AuraBoxConn = RunService.RenderStepped:Connect(function()
        if not AuraHitboxActive or not AuraBoxPart then return end
        local char = LocalPlayer.Character
        if not (char and char:FindFirstChild("HumanoidRootPart")) then return end

        local root = char.HumanoidRootPart
        AuraBoxPart.CFrame = root.CFrame * CFrame.new(0, -0.5, 0)

        local enemyInside = false
        local myPos = root.Position

        for _, model in ipairs(Workspace:GetDescendants()) do
            if model:IsA("Model") and model ~= char then
                local hum = model:FindFirstChildOfClass("Humanoid")
                local mRoot = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChildWhichIsA("BasePart")
                if hum and hum.Health > 0 and mRoot and not Players:GetPlayerFromCharacter(model) then
                    local offset = mRoot.Position - myPos
                    if math.abs(offset.X) <= 8.5 and math.abs(offset.Z) <= 8.5 then
                        enemyInside = true
                        break
                    end
                end
            end
        end

        if enemyInside then
            AuraBoxPart.Color = C.Red
            executeTackle()
        else
            AuraBoxPart.Color = HitboxColors[CurrentColorIndex].color
        end
    end)
end

-- 6. AUTO-DODGE & SPEED
local AutoDodgeActive = false
local DodgeCooldown = 0
local AutoDodgeConn = nil

local function triggerDodge()
    if tick() - DodgeCooldown < 0.9 then return end
    DodgeCooldown = tick()
    local char = LocalPlayer.Character
    if char and char:FindFirstChildOfClass("Humanoid") then
        local hum = char:FindFirstChildOfClass("Humanoid")
        hum.Jump = true
        hum:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end

local function setupAutoDodge()
    if AutoDodgeConn then AutoDodgeConn:Disconnect(); AutoDodgeConn = nil end
    AutoDodgeConn = RunService.Heartbeat:Connect(function()
        if not AutoDodgeActive then return end
        local char = LocalPlayer.Character
        if not (char and char:FindFirstChild("HumanoidRootPart")) then return end
        local myPos = char.HumanoidRootPart.Position

        for _, model in ipairs(Workspace:GetDescendants()) do
            if model:IsA("Model") and model ~= char then
                local hum = model:FindFirstChildOfClass("Humanoid")
                local root = model:FindFirstChild("HumanoidRootPart")
                if hum and hum.Health > 0 and root and not Players:GetPlayerFromCharacter(model) then
                    local dist = (root.Position - myPos).Magnitude
                    if dist <= 12 then
                        triggerDodge()
                        break
                    end
                end
            end
        end
    end)
end

local SpeedOptions = {16, 24, 28, 32}
local SpeedIndex = 1
local SpeedConn = nil

local function applySpeed()
    local char = LocalPlayer.Character
    if char and char:FindFirstChildOfClass("Humanoid") then
        char:FindFirstChildOfClass("Humanoid").WalkSpeed = SpeedOptions[SpeedIndex]
    end
end

