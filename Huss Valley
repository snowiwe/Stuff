-- 11. MAP RAYCASTING & BOUNDARIES
local edgeRayCache = {map = nil, field = nil, invisWall = nil, params = nil, wallParams = nil}

local function refreshEdgeRayCache()
    local map = getMap()
    local field = map and (map:FindFirstChild("Field") or map:FindFirstChild("Field", true))
    local wall = field and field:FindFirstChild("InvisWall", true)
    local include = field or map
    if edgeRayCache.map == map and edgeRayCache.field == field and edgeRayCache.invisWall == wall and edgeRayCache.params then
        return
    end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Include
    params.FilterDescendantsInstances = include and {include} or {}
    params.IgnoreWater = true
    edgeRayCache.map = map
    edgeRayCache.field = field
    edgeRayCache.invisWall = wall
    edgeRayCache.params = params
    edgeRayCache.wallParams = nil
end

local function getEdgeRayParams()
    refreshEdgeRayCache()
    return edgeRayCache.params
end

local function getInvisWallParams()
    refreshEdgeRayCache()
    local wall = edgeRayCache.invisWall
    if not wall or not wall:IsDescendantOf(workspace) then
        edgeRayCache.invisWall = nil
        edgeRayCache.wallParams = nil
        return nil
    end
    if edgeRayCache.wallParams then return edgeRayCache.wallParams end
    local wallParams = RaycastParams.new()
    wallParams.FilterType = Enum.RaycastFilterType.Include
    wallParams.FilterDescendantsInstances = {wall}
    wallParams.IgnoreWater = true
    edgeRayCache.wallParams = wallParams
    return wallParams
end

local function invisWallHit(position, direction, distance)
    local dir = flat(direction)
    if dir.Magnitude < 0.05 then return nil end
    local params = getInvisWallParams()
    if not params then return nil end
    return workspace:Raycast(Vector3.new(position.X, position.Y + 2.5, position.Z), dir.Unit * distance, params)
end

local function hasFloorAt(point, y)
    local map = getMap()
    if not map then return true end
    local params = getEdgeRayParams()
    if not params or #params.FilterDescendantsInstances == 0 then return false end
    local origin = Vector3.new(point.X, math.max(y + 12, point.Y + 10), point.Z)
    local hit = workspace:Raycast(origin, Vector3.new(0, -(SETTINGS.edgeRayHeight + SETTINGS.edgeRayDepth), 0), params)
    return hit ~= nil and hit.Normal.Y >= 0.35
end

local function groundSupportScore(position, direction, y)
    local dir = flat(direction)
    if dir.Magnitude < 0.05 then return 0 end
    dir = dir.Unit
    local side = Vector3.new(-dir.Z, 0, dir.X)
    local score = 0
    if hasFloorAt(position + dir * 6, y) then score += 2 end
    if hasFloorAt(position + dir * 14, y) then score += 2 end
    if hasFloorAt(position + dir * 24, y) then score += 1 end
    if hasFloorAt(position + dir * 14 + side * 3, y) then score += 1 end
    if hasFloorAt(position + dir * 14 - side * 3, y) then score += 1 end
    return score
end

local function boundaryInwardDirection(position, y)
    local dirs = {Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0), Vector3.new(0, 0, 1), Vector3.new(0, 0, -1)}
    local outward = Vector3.zero
    local missing = 0
    for _, dir in ipairs(dirs) do
        if invisWallHit(position, dir, 9) or not hasFloorAt(position + dir * 7, y) then
            outward += dir
            missing += 1
        end
    end
    if missing == 0 or outward.Magnitude < 0.05 then return Vector3.zero end
    local inward = flat(-outward)
    if inward.Magnitude < 0.05 or groundSupportScore(position, inward.Unit, y) < 3 then return Vector3.zero end
    return inward.Unit
end

local function edgeDirectionClear(position, direction, y, distance)
    local dir = flat(direction)
    if dir.Magnitude < 0.05 then return false end
    dir = dir.Unit
    if invisWallHit(position, dir, math.max(8, distance)) then return false end
    return groundSupportScore(position, dir, y) >= (distance <= 14 and 4 or 5)
end

local function rotateEdge(dir, angle)
    local r = math.rad(angle)
    local c = math.cos(r)
    local s = math.sin(r)
    return Vector3.new(dir.X * c - dir.Z * s, 0, dir.X * s + dir.Z * c)
end

local function getPlayfieldCenter()
    if safezone.a and safezone.b then return (safezone.a.center + safezone.b.center) * 0.5 end
    return (safezone.a and safezone.a.center) or (safezone.b and safezone.b.center) or nil
end

local function chooseEdgeDirection(position, desired, goal, y)
    local dir = flat(desired)
    if dir.Magnitude < 0.05 then return Vector3.zero, false end
    dir = dir.Unit
    local boundary = boundaryInwardDirection(position, y)
    local risk = not edgeDirectionClear(position, dir, y, SETTINGS.edgeLookAhead) or not edgeDirectionClear(position, dir, y, SETTINGS.edgeSecondLookAhead)
    local nearBoundary = boundary.Magnitude > 0.05 and boundary:Dot(dir) < 0.35

    if not risk and not nearBoundary then
        runtime.edgeDirection = dir
        runtime.edgeRisk = false
        return dir, false
    end

    local toGoal = flat(goal - position)
    toGoal = toGoal.Magnitude > 0.05 and toGoal.Unit or dir
    local inward = boundary
    if inward.Magnitude < 0.05 then
        local center = getPlayfieldCenter()
        if center then
            local cDir = flat(center - position)
            inward = cDir.Magnitude > 0.05 and cDir.Unit or Vector3.zero
        end
    end

    local candidates = {}
    local function addCandidate(v)
        v = flat(v)
        if v.Magnitude < 0.05 then return end
        v = v.Unit
        for _, item in ipairs(candidates) do
            if item:Dot(v) > 0.985 then return end
        end
        candidates[#candidates + 1] = v
    end

    addCandidate(inward); addCandidate(toGoal); addCandidate(dir)
    local base = inward.Magnitude > 0.05 and inward or dir
    for _, angle in ipairs({-35, 35, -70, 70, 90, -90, 135, -135, 180}) do
        addCandidate(rotateEdge(base, angle))
    end

    local best, bestScore = nil, -math.huge
    for _, cand in ipairs(candidates) do
        local support = groundSupportScore(position, cand, y)
        if support >= 6 then
            local score = support * 4.5 + cand:Dot(toGoal) * 5
            if inward.Magnitude > 0.05 then score += cand:Dot(inward) * (nearBoundary and 10 or 5) end
            if score > bestScore then bestScore = score; best = cand end
        end
    end

    if best then
        runtime.edgeDirection = best
        runtime.edgeRisk = true
        return best, true
    end

    runtime.edgeDirection = inward.Magnitude > 0.05 and inward or -dir
    runtime.edgeRisk = true
    return runtime.edgeDirection, true
end

-- 12. SAFEZONE TRACKING
local function findZone(parent, names)
    for _, name in ipairs(names) do
        local d = parent:FindFirstChild(name)
        if d then return d end
    end
    for _, obj in ipairs(parent:GetDescendants()) do
        local lower = obj.Name:lower()
        for _, name in ipairs(names) do
            if lower == name:lower() then return obj end
        end
    end
    return nil
end

local function getBounds(instance)
    if not instance then return nil end
    local minP = Vector3.new(math.huge, math.huge, math.huge)
    local maxP = Vector3.new(-math.huge, -math.huge, -math.huge)
    local found = false
    local function add(part)
        local p = part.Position
        local h = part.Size * 0.5
        minP = Vector3.new(math.min(minP.X, p.X - h.X), math.min(minP.Y, p.Y - h.Y), math.min(minP.Z, p.Z - h.Z))
        maxP = Vector3.new(math.max(maxP.X, p.X + h.X), math.max(maxP.Y, p.Y + h.Y), math.max(maxP.Z, p.Z + h.Z))
        found = true
    end
    if instance:IsA("BasePart") then add(instance) end
    for _, obj in ipairs(instance:GetDescendants()) do
        if obj:IsA("BasePart") then add(obj) end
    end
    return found and minP or nil, maxP
end

local function buildZone(instance)
    local minP, maxP = getBounds(instance)
    if not minP then return nil end
    return {instance = instance, name = instance.Name, min = minP, max = maxP, center = (minP + maxP) * 0.5}
end

local function refreshSafezones()
    local map = getMap()
    if safezone.cached and safezone.map == map and safezone.a and safezone.b and safezone.a.instance.Parent and safezone.b.instance.Parent then
        return
    end
    safezone.map = map
    safezone.cached = true
    local field = map and map:FindFirstChild("Field")
    if not field then return end
    safezone.a = buildZone(findZone(field, {"SafezoneASide", "SafeZoneASide"}))
    safezone.b = buildZone(findZone(field, {"SafezoneBSide", "SafeZoneBSide"}))
end

local function inZone(pos, z)
    return z and pos.X >= z.min.X and pos.X <= z.max.X and pos.Z >= z.min.Z and pos.Z <= z.max.Z and pos.Y >= z.min.Y - 8 and pos.Y <= z.max.Y + 8
end

local function currentZone(pos)
    if inZone(pos, safezone.a) then return safezone.a end
    if inZone(pos, safezone.b) then return safezone.b end
    return nil
end

local function zoneInwardDirection(zone, other)
    if not zone then return Vector3.zero end
    local delta = other and flat(zone.center - other.center) or Vector3.zero
    if delta.Magnitude > 0.05 then
        return math.abs(delta.X) >= math.abs(delta.Z) and Vector3.new(delta.X >= 0 and 1 or -1, 0, 0) or Vector3.new(0, 0, delta.Z >= 0 and 1 or -1)
    end
    return Vector3.zero
end

local function zoneAxisHalfExtent(zone, inward)
    if not zone then return 0 end
    local size = zone.max - zone.min
    return math.abs(math.abs(inward.X) >= math.abs(inward.Z) and size.X or size.Z) * 0.5
end

local function zoneDeepPoint(zone, other, y)
    if not zone then return nil end
    local inward = zoneInwardDirection(zone, other)
    local half = zoneAxisHalfExtent(zone, inward)
    local edgeMargin = math.min(SETTINGS.safezoneEdgeMargin, math.max(0, half - 0.75))
    local xMargin = math.min(edgeMargin, math.max(0, (zone.max.X - zone.min.X) * 0.5 - 0.75))
    local zMargin = math.min(edgeMargin, math.max(0, (zone.max.Z - zone.min.Z) * 0.5 - 0.75))
    local depth = math.min(math.max(0, half - edgeMargin), half * SETTINGS.safezoneDepthRatio)
    local point = zone.center + inward * depth
    return Vector3.new(math.clamp(point.X, zone.min.X + xMargin, zone.max.X - xMargin), y, math.clamp(point.Z, zone.min.Z + zMargin, zone.max.Z - zMargin))
end

local function inValidatedZone(position, zone, other)
    if not zone or not inZone(position, zone) then return false end
    local inward = zoneInwardDirection(zone, other)
    local half = zoneAxisHalfExtent(zone, inward)
    local margin = math.min(SETTINGS.safezoneEdgeMargin, math.max(0, half - 0.75))
    local depth = flat(position - zone.center):Dot(inward)
    return depth >= math.min(math.max(0, half - margin), half * SETTINGS.safezoneValidationRatio) and hasFloorAt(position, position.Y)
end

local function chooseSafeGoal(position)
    refreshSafezones()
    local a, b = safezone.a, safezone.b
    if not a or not b then return nil, nil end
    if not runtime.routeActive or not runtime.routeTargetSide then
        local inA = inZone(position, a)
        local start = (inA and a) or (inZone(position, b) and b) or (flat(position - a.center).Magnitude <= flat(position - b.center).Magnitude and a or b)
        local target = start == a and b or a
        runtime.routeActive = true
        runtime.routeComplete = false
        runtime.routeStartSide = start.name
        runtime.routeTargetSide = target.name
        runtime.goalSide = target.name
        runtime.goal = zoneDeepPoint(target, start, position.Y) or target.center
        return runtime.goal, target
    end
    if runtime.routeComplete then return nil, nil end

    local target = runtime.routeTargetSide == a.name and a or b
    local other = target == a and b or a
    if inValidatedZone(position, target, other) then
        runtime.routeComplete = true
        runtime.routeCompletePosition = position
        runtime.routeCompleteAt = os.clock()
        runtime.goal = nil
        return nil, target
    end
    runtime.goalSide = target.name
    runtime.goal = zoneDeepPoint(target, other, position.Y) or target.center
    return runtime.goal, target
end

local function getSafeFallback(position)
    refreshSafezones()
    local a, b = safezone.a, safezone.b
    if not a or not b then return nil end
    local target = (runtime.routeTargetSide == a.name and a) or (runtime.routeTargetSide == b.name and b) or (inZone(position, a) and b) or a
    return zoneDeepPoint(target, target == a and b or a, position.Y) or target.center
end

-- 13. RUNNER NAVIGATION & THREAT AVOIDANCE
local function isGemObject(obj)
    local name = obj.Name:lower()
    return obj:IsA("BasePart") and (name:sub(1, 4) == "gem_" or name == "gem" or name == "gems" or name:find("gempickup", 1, true) ~= nil)
end

local function refreshGems(now, position)
    if now - runtime.gemScanAt < SETTINGS.gemScanInterval then return end
    runtime.gemScanAt = now
    local best, bestDist
    local folder = workspace:FindFirstChild("LocalRunnerGems") or workspace:FindFirstChild("Gems") or workspace:FindFirstChild("Gem")
    if folder then
        for _, obj in ipairs(folder:IsA("Folder") and folder:GetChildren() or folder:GetDescendants()) do
            if isGemObject(obj) and obj.Parent then
                local d = flat(obj.Position - position).Magnitude
                local ignored = runtime.gemIgnored[obj]
                if d <= SETTINGS.gemMaxDistance and (not ignored or now >= ignored) then
                    if not bestDist or d < bestDist then best = obj; bestDist = d end
                end
            end
        end
    end
    runtime.gemTarget = best
end

local function findDownedPlayer(position)
    local best, bestDist
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Parent then
            local c = p.Character
            local root = c and c:FindFirstChild("HumanoidRootPart")
            if root and c:GetAttribute("RescueAvailable") == true and c:GetAttribute("Ragdolled") == true then
                local helper = c:GetAttribute("RescueHelperId")
                if helper == nil or helper == LocalPlayer.UserId then
                    local d = flat(root.Position - position).Magnitude
                    if d <= SETTINGS.reviveMaxDistance and (not bestDist or d < bestDist) then
                        best = p; bestDist = d
                    end
                end
            end
        end
    end
    return best
end

local function cancelRevive()
    if runtime.reviveTarget and runtime.reviveStarted then
        pcall(function() RescueEvent:FireServer("Cancel", runtime.reviveTarget.UserId) end)
    end
    runtime.reviveTarget = nil
    runtime.reviveStarted = false
    runtime.reviveStartAt = 0
end

local function updateRevive(now, position)
    if not SETTINGS.autoRevive then cancelRevive(); return nil end
    local target = runtime.reviveTarget
    local root = target and getRoot(target)
    if not target or not target.Parent or not root or target.Character:GetAttribute("RescueAvailable") ~= true or target.Character:GetAttribute("Ragdolled") ~= true then
        cancelRevive(); target = nil
    end
    if not target then
        target = findDownedPlayer(position)
        if not target then return nil end
        runtime.reviveTarget = target
    end
    root = getRoot(target)
    if not root then cancelRevive(); return nil end
    local dist = flat(root.Position - position).Magnitude
    if dist <= RESCUE_RANGE then
        if not runtime.reviveStarted then
            runtime.reviveStarted = true
            runtime.reviveStartAt = now
            pcall(function() RescueEvent:FireServer("Begin", target.UserId) end)
        elseif now - runtime.reviveStartAt >= RESCUE_HOLD then
            pcall(function() RescueEvent:FireServer("Finish", target.UserId) end)
            runtime.reviveStarted = false
            runtime.reviveStartAt = now + RESCUE_FINISH_GRACE + 0.5
        end
    else
        if runtime.reviveStarted then cancelRevive() end
    end
    return root.Position
end

local function refreshCatchers(now)
    if now - runtime.catcherCacheAt < 0.12 then return end
    runtime.catcherCacheAt = now
    table.clear(runtime.catchers)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Parent and p:GetAttribute("GameRole") == "Catcher" and p:GetAttribute("RunState") == "Active" then
            local c = p.Character
            local h = c and c:FindFirstChildOfClass("Humanoid")
            if h and h.Health > 0 and c:FindFirstChild("HumanoidRootPart") and c:GetAttribute("Ragdolled") ~= true then
                table.insert(runtime.catchers, p)
            end
        end
    end
end

local function updateThreats(now, position)
    if now - runtime.threatAt < 0.045 then return runtime.threats end
    runtime.threatAt = now
    table.clear(runtime.threats)
    local runSpeed = math.max(getRunnerSpeed(), 1)

    for _, p in ipairs(runtime.catchers) do
        local root = getRoot(p)
        if root then
            local current = flat(root.Position)
            local dist = (current - position).Magnitude
            if dist <= 105 then
                local vel = flat(root.AssemblyLinearVelocity)
                local danger = 8
                local closing = dist > 0.05 and math.max(0, vel:Dot(-(current - position).Unit)) or 0
                local timeToDanger = closing > 0.5 and math.max(0, (dist - danger) / closing) or math.huge
                local collisionRisk = timeToDanger <= 0.65 or dist <= danger * 1.35
                table.insert(runtime.threats, {
                    player = p, root = root, position = current, velocity = vel,
                    distance = dist, closing = closing, danger = danger,
                    collisionRisk = collisionRisk, timeToDanger = timeToDanger,
                    intercept = current + vel * math.min(timeToDanger, 0.65)
                })
            end
        end
    end
    table.sort(runtime.threats, function(a, b) return a.distance < b.distance end)
    return runtime.threats
end

local function routeClear(position, direction, threats)
    if direction.Magnitude < 0.05 then return -math.huge end
    local dir = direction.Unit
    local speed = math.max(getRunnerSpeed(), 1)
    local clearance = math.huge
    for _, t in ipairs({0.10, 0.25, 0.45, 0.70}) do
        local runner = position + dir * speed * t
        for _, threat in ipairs(threats) do
            local catchPos = threat.position + threat.velocity * t
            local safe = flat(runner - catchPos).Magnitude - threat.danger
            if safe < clearance then clearance = safe end
        end
    end
    return clearance
end

local function chooseRunnerDirection(position, goal, threats)
    local desired = flat(goal - position)
    if desired.Magnitude < 0.05 then return Vector3.zero end
    desired = desired.Unit
    if not SETTINGS.avoidCatchers or #threats == 0 then return desired end

    local best, bestScore = desired, -math.huge
    local candidates = {desired}
    for _, angle in ipairs({15, -15, 30, -30, 45, -45, 65, -65, 85, -85}) do
        table.insert(candidates, rotateEdge(desired, angle))
    end

    for _, cand in ipairs(candidates) do
        local progress = cand:Dot(desired)
        local clearance = routeClear(position, cand, threats)
        local score = progress * 10 + math.min(clearance, 20) * 2.4 * SETTINGS.avoidStrength
        if clearance < 0 then
            score -= math.abs(clearance) * 18 * SETTINGS.avoidStrength
        elseif clearance < 5 then
            score -= (5 - clearance) * 5 * SETTINGS.avoidStrength
        end
        if score > bestScore then bestScore = score; best = cand end
    end
    return best.Unit
end

local function requestDash(direction, now)
    if not SETTINGS.autoDash or not isRunnerActive() then return false end
    if now - runtime.dashAt < SETTINGS.dashCooldown then return false end
    local ok, available = pcall(BoostInput.available, LocalPlayer)
    if ok and available == true then
        pcall(BoostInput.request, nil)
        runtime.dashAt = now
        return true
    end
    return false
end

local function runnerStep(now, dt)
    if not isRunnerActive() or not SETTINGS.runnerEnabled then
        runtime.path = Vector3.zero
        if runtime.reviveStarted then cancelRevive() end
        return
    end
    local root = getRoot()
    local hum = getHumanoid()
    if not root or not hum or not canMove() then
        runtime.path = Vector3.zero
        return
    end

    refreshPing(now)
    refreshSafezones()
    refreshCatchers(now)
    local position = root.Position
    local baseGoal = select(1, chooseSafeGoal(position)) or getSafeFallback(position)
    if not baseGoal then
        hum:Move(Vector3.zero, false)
        return
    end

    local movementGoal = baseGoal
    if SETTINGS.autoRevive then
        local revivePos = updateRevive(now, position)
        if revivePos then movementGoal = revivePos end
    elseif SETTINGS.autoGems then
        refreshGems(now, position)
        if runtime.gemTarget and runtime.gemTarget.Parent then
            movementGoal = runtime.gemTarget.Position
            if flat(movementGoal - position).Magnitude <= SETTINGS.gemCollectDistance then
                runtime.gemIgnored[runtime.gemTarget] = now + 0.7
                runtime.gemTarget = nil
            end
        end
    end

    if runtime.reviveStarted then
        hum:Move(Vector3.zero, false)
        runtime.path = Vector3.zero
        return
    end

    local threats = updateThreats(now, position)
    local dir = chooseRunnerDirection(position, movementGoal, threats)
    local edgeDir, edgeRisk = chooseEdgeDirection(position, dir, movementGoal, position.Y)
    if edgeRisk and edgeDir.Magnitude > 0.05 then dir = edgeDir end

    if SETTINGS.smoothMovement and runtime.path.Magnitude > 0.05 then
        local alpha = math.clamp(SETTINGS.turnRate * dt, 0, 1)
        dir = flat(runtime.path:Lerp(dir, alpha)).Unit
    end

    runtime.path = dir
    hum.AutoRotate = true
    hum:Move(dir, false)

    if SETTINGS.autoDash and #threats > 0 and threats[1].collisionRisk then
        requestDash(dir, now)
    end
end

