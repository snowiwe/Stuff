local function refreshRunnerTargets(now)
    if now - runtime.catcherTargetAt < 0.15 then return end
    runtime.catcherTargetAt = now
    table.clear(runtime.catcherTargets)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Parent and p:GetAttribute("GameRole") == "Runner" and p:GetAttribute("RunState") == "Active" then
            local c = p.Character
            local h = c and c:FindFirstChildOfClass("Humanoid")
            if h and h.Health > 0 and c:FindFirstChild("HumanoidRootPart") and c:GetAttribute("Ragdolled") ~= true then
                table.insert(runtime.catcherTargets, p)
            end
        end
    end
end

local function catcherAttack(target, now, root)
    local targetRoot = getRoot(target)
    if not targetRoot then return end
    local dist = flat(targetRoot.Position - root.Position).Magnitude
    local meleeReady = SETTINGS.autoMelee and now - runtime.lastMelee >= SETTINGS.meleeCooldown and dist <= SETTINGS.meleeRange
    local tackleReady = SETTINGS.autoTackle and now - runtime.lastTackle >= SETTINGS.tackleCooldown and dist <= SETTINGS.tackleRange

    if tackleReady and (SETTINGS.catcherAttackPriority == "Tackle First" or dist > SETTINGS.meleeRange) then
        pcall(TacklePrediction.request)
        runtime.lastTackle = now
    elseif meleeReady then
        runtime.meleeId += 1
        pcall(MeleeEvent.FireServer, MeleeEvent, runtime.meleeId)
        runtime.lastMelee = now
    end
end

local function catcherStep(now, dt)
    if not isCatcherActive() or not SETTINGS.catcherChase then
        runtime.catcherTarget = nil
        return
    end
    local root = getRoot()
    local hum = getHumanoid()
    if not root or not hum or not canMove() then return end

    refreshRunnerTargets(now)
    local best, bestDist
    for _, p in ipairs(runtime.catcherTargets) do
        local r = getRoot(p)
        if r then
            local d = flat(r.Position - root.Position).Magnitude
            if not bestDist or d < bestDist then best = p; bestDist = d end
        end
    end

    runtime.catcherTarget = best
    if not best then return end
    local targetRoot = getRoot(best)
    if not targetRoot then return end

    local predicted = targetRoot.Position + flat(targetRoot.AssemblyLinearVelocity) * SETTINGS.catcherPrediction
    local dir = flat(predicted - root.Position)
    if dir.Magnitude > 0.05 then
        dir = dir.Unit
        if SETTINGS.smoothTurn and runtime.catcherPath.Magnitude > 0.05 then
            dir = flat(runtime.catcherPath:Lerp(dir, math.clamp(SETTINGS.turnRateCatcher * dt, 0, 1))).Unit
        end
        runtime.catcherPath = dir
        hum.AutoRotate = true
        hum:Move(dir, false)
    end

    if SETTINGS.autoTackle or SETTINGS.autoMelee then catcherAttack(best, now, root) end
    if SETTINGS.followTarget and workspace.CurrentCamera then
        workspace.CurrentCamera.CFrame = workspace.CurrentCamera.CFrame:Lerp(
            CFrame.lookAt(workspace.CurrentCamera.CFrame.Position, predicted + Vector3.new(0, 1.5, 0)),
            math.clamp(SETTINGS.cameraResponse, 0.01, 1)
        )
    end
end

