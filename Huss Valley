-- 10. HELPER FUNCTIONS
local function flat(v) return Vector3.new(v.X, 0, v.Z) end
local function getCharacter(player) return (player or LocalPlayer).Character end
local function getHumanoid(player)
    local c = getCharacter(player)
    return c and c:FindFirstChildOfClass("Humanoid") or nil
end
local function getRoot(player)
    local c = getCharacter(player)
    return c and c:FindFirstChild("HumanoidRootPart") or nil
end
local function getRole() return LocalPlayer:GetAttribute("GameRole") or "Lobby" end
local function getRunState() return LocalPlayer:GetAttribute("RunState") or "Idle" end

local function isRunnerActive()
    return LocalPlayer:GetAttribute("InMatch") == true and getRole() == "Runner" and getRunState() == "Active"
end

local function isCatcherActive()
    return LocalPlayer:GetAttribute("InMatch") == true and getRole() == "Catcher" and getRunState() == "Active"
end

local function canMove()
    if LocalPlayer:GetAttribute("ClientReady") ~= true then return false end
    if Session:GetAttribute("GlobalPaused") == true or Session:GetAttribute("MapChanging") == true then return false end
    local c = getCharacter()
    if not c or c:GetAttribute("Ragdolled") == true or c:GetAttribute("GearMotion") == true or c:GetAttribute("MovementLocked") == true then
        return false
    end
    local h = getHumanoid()
    return h and h.Health > 0 and not h.PlatformStand and not h.Sit
end

local function refreshPing(now)
    if now - runtime.pingAt < 0.5 then return end
    runtime.pingAt = now
    local val = 0
    pcall(function() val = LocalPlayer:GetNetworkPing() * 0.5 end)
    runtime.ping = math.max(val, 0)
end

-- 11. RUNNER ACTIONS (REVIVE, GEMS, DASH)
local function isGemObject(obj)
    local name = obj.Name:lower()
    return obj:IsA("BasePart") and (name:sub(1, 4) == "gem_" or name == "gem" or name == "gems" or name:find("gempickup", 1, true) ~= nil)
end

local function refreshGems(now, position)
    if now - runtime.gemScanAt < SETTINGS.gemScanInterval then return end
    runtime.gemScanAt = now
    local best, bestDist
    local folder = workspace:FindFirstChild("LocalRunnerGems") or workspace:FindFirstChild("Gems") or workspace:FindFirstChild("Gem")
    if folder then
        for _, obj in ipairs(folder:IsA("Folder") and folder:GetChildren() or folder:GetDescendants()) do
            if isGemObject(obj) and obj.Parent then
                local d = flat(obj.Position - position).Magnitude
                local ignored = runtime.gemIgnored[obj]
                if d <= SETTINGS.gemMaxDistance and (not ignored or now >= ignored) then
                    if not bestDist or d < bestDist then best = obj; bestDist = d end
                end
            end
        end
    end
    runtime.gemTarget = best
end

local function findDownedPlayer(position)
    local best, bestDist
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Parent then
            local c = p.Character
            local root = c and c:FindFirstChild("HumanoidRootPart")
            if root and c:GetAttribute("RescueAvailable") == true and c:GetAttribute("Ragdolled") == true then
                local helper = c:GetAttribute("RescueHelperId")
                if helper == nil or helper == LocalPlayer.UserId then
                    local d = flat(root.Position - position).Magnitude
                    if d <= SETTINGS.reviveMaxDistance and (not bestDist or d < bestDist) then
                        best = p; bestDist = d
                    end
                end
            end
        end
    end
    return best
end

local function cancelRevive()
    if runtime.reviveTarget and runtime.reviveStarted then
        pcall(function() RescueEvent:FireServer("Cancel", runtime.reviveTarget.UserId) end)
    end
    runtime.reviveTarget = nil
    runtime.reviveStarted = false
    runtime.reviveStartAt = 0
end

local function updateRevive(now, position)
    if not SETTINGS.autoRevive then cancelRevive(); return nil end
    local target = runtime.reviveTarget
    local root = target and getRoot(target)
    if not target or not target.Parent or not root or target.Character:GetAttribute("RescueAvailable") ~= true or target.Character:GetAttribute("Ragdolled") ~= true then
        cancelRevive(); target = nil
    end
    if not target then
        target = findDownedPlayer(position)
        if not target then return nil end
        runtime.reviveTarget = target
    end
    root = getRoot(target)
    if not root then cancelRevive(); return nil end
    local dist = flat(root.Position - position).Magnitude
    if dist <= RESCUE_RANGE then
        if not runtime.reviveStarted then
            runtime.reviveStarted = true
            runtime.reviveStartAt = now
            pcall(function() RescueEvent:FireServer("Begin", target.UserId) end)
        elseif now - runtime.reviveStartAt >= RESCUE_HOLD then
            pcall(function() RescueEvent:FireServer("Finish", target.UserId) end)
            runtime.reviveStarted = false
            runtime.reviveStartAt = now + RESCUE_FINISH_GRACE + 0.5
        end
    else
        if runtime.reviveStarted then cancelRevive() end
    end
    return root.Position
end

local function requestDash(direction, now)
    if not SETTINGS.autoDash or not isRunnerActive() then return false end
    if now - runtime.dashAt < SETTINGS.dashCooldown then return false end
    local ok, available = pcall(BoostInput.available, LocalPlayer)
    if ok and available == true then
        pcall(BoostInput.request, nil)
        runtime.dashAt = now
        return true
    end
    return false
end

local function runnerStep(now, dt)
    if not isRunnerActive() then
        if runtime.reviveStarted then cancelRevive() end
        return
    end
    local root = getRoot()
    local hum = getHumanoid()
    if not root or not hum or not canMove() then return end

    refreshPing(now)
    local position = root.Position

    if SETTINGS.autoRevive then
        local revivePos = updateRevive(now, position)
        if revivePos and not runtime.reviveStarted then
            local dir = flat(revivePos - position)
            if dir.Magnitude > 0.05 then
                hum:Move(dir.Unit, false)
            end
        end
    elseif SETTINGS.autoGems then
        refreshGems(now, position)
        if runtime.gemTarget and runtime.gemTarget.Parent then
            local gemPos = runtime.gemTarget.Position
            local dist = flat(gemPos - position).Magnitude
            if dist <= SETTINGS.gemCollectDistance then
                runtime.gemIgnored[runtime.gemTarget] = now + 0.7
                runtime.gemTarget = nil
            else
                local dir = flat(gemPos - position)
                if dir.Magnitude > 0.05 then
                    hum:Move(dir.Unit, false)
                end
            end
        end
    end

    if runtime.reviveStarted then
        hum:Move(Vector3.zero, false)
    end
end

-- 12. CATCHER ACTIONS (MELEE)
local function refreshRunnerTargets(now)
    if now - runtime.catcherTargetAt < 0.15 then return end
    runtime.catcherTargetAt = now
    table.clear(runtime.catcherTargets)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Parent and p:GetAttribute("GameRole") == "Runner" and p:GetAttribute("RunState") == "Active" then
            local c = p.Character
            local h = c and c:FindFirstChildOfClass("Humanoid")
            if h and h.Health > 0 and c:FindFirstChild("HumanoidRootPart") and c:GetAttribute("Ragdolled") ~= true then
                table.insert(runtime.catcherTargets, p)
            end
        end
    end
end

local function catcherAttack(target, now, root)
    local targetRoot = getRoot(target)
    if not targetRoot then return end
    local dist = flat(targetRoot.Position - root.Position).Magnitude
    local meleeReady = SETTINGS.autoMelee and now - runtime.lastMelee >= SETTINGS.meleeCooldown and dist <= SETTINGS.meleeRange

    if meleeReady then
        runtime.meleeId += 1
        pcall(MeleeEvent.FireServer, MeleeEvent, runtime.meleeId)
        runtime.lastMelee = now
    end
end

local function catcherStep(now, dt)
    if not isCatcherActive() or not SETTINGS.autoMelee then return end
    local root = getRoot()
    if not root or not canMove() then return end

    refreshRunnerTargets(now)
    for _, p in ipairs(runtime.catcherTargets) do
        catcherAttack(p, now, root)
    end
end

-- 13. AUTOMATED UTILITIES (WHEEL, JOURNEY, MAP VOTE)
local function wheelRequestState(now)
    if now - runtime.wheelStateRequestAt < 1.25 then return end
    runtime.wheelStateRequestAt = now
    pcall(function() SpinWheelEvent:FireServer("State") end)
end

local function autoSpinWheelStep(now)
    if not SETTINGS.autoSpinWheel or LocalPlayer:GetAttribute("InMatch") == true or runtime.wheelSpinning then return end
    wheelRequestState(now)
    local credits = math.floor(tonumber(runtime.wheelCredits) or 0)
    if credits >= SETTINGS.wheelMinimumCredits and now >= runtime.wheelNextAttemptAt then
        runtime.wheelSpinning = true
        runtime.wheelNextAttemptAt = now + SETTINGS.wheelSpinInterval
        runtime.wheelSpinCount += 1
        pcall(function() SpinWheelEvent:FireServer("Spin") end)
        if SETTINGS.wheelAnnounce then Notify("Wheel", "Spin #" .. runtime.wheelSpinCount .. " dispatched", C.Accent) end
        task.delay(1.2, function()
            runtime.wheelSpinning = false
            wheelRequestState(os.clock())
        end)
    end
end

local function mapVoteStep(now)
    if not SETTINGS.autoMapVote or LocalPlayer:GetAttribute("InMatch") == true or now - runtime.mapVoteLastActionAt < 1.5 then return end
    if not MapVoteState or not MapVoteState:IsA("StringValue") then return end
    local ok, state = pcall(function() return HttpService:JSONDecode(MapVoteState.Value) end)
    if ok and type(state) == "table" and state.phase == "Voting" and state.token then
        local targetSlot = SETTINGS.mapVoteSelections[1] or "Map 1"
        local idx = table.find(MAP_VOTE_SLOT_IDS, targetSlot)
        local optId = idx and state.options and state.options[idx] and (state.options[idx].id or state.options[idx].Id)
        if optId then
            runtime.mapVoteLastActionAt = now
            pcall(function() MapVoteEvent:FireServer("Vote", optId, state.token) end)
            Notify("Map Vote", targetSlot .. " vote cast", C.Cyan)
        end
    end
end

SpinWheelEvent.OnClientEvent:Connect(function(kind, payload)
    if kind == "State" and type(payload) == "table" then
        runtime.wheelCredits = tonumber(payload.credits) or 0
        runtime.wheelNextFreeAt = tonumber(payload.nextFreeAt) or 0
        if payload.result or payload.message then runtime.wheelSpinning = false end
    end
end)

JourneyEvent.OnClientEvent:Connect(function(action, data)
    if action == "State" and type(data) == "table" then
        runtime.journeyLoaded = data.loaded == true
        runtime.journeySeasonId = data.seasonId or JourneyConfig.SeasonId
        runtime.journeyTier = tonumber(data.tier) or 1
        runtime.journeyPremium = data.premium == true
        runtime.journeyClaims = type(data.claims) == "table" and data.claims or {}
        runtime.journeyClaimInFlight = false
    end
end)

local function journeyClaimStep(now)
    if not SETTINGS.autoClaimJourneyRewards or LocalPlayer:GetAttribute("InMatch") == true or runtime.journeyClaimInFlight or now < runtime.journeyNextClaimAt then return end
    if not runtime.journeyLoaded then
        pcall(function() JourneyEvent:FireServer("Get") end)
        runtime.journeyNextClaimAt = now + 2.0
        return
    end
    runtime.journeyClaimInFlight = true
    runtime.journeyNextClaimAt = now + 4.0
    pcall(function() JourneyEvent:FireServer("ClaimAll", nil, runtime.journeySeasonId or JourneyConfig.SeasonId) end)
    Notify("Journey", "Claimed seasonal rewards", C.Green)
end

