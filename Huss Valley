local function canMove()
    if LocalPlayer:GetAttribute("ClientReady") ~= true then return false end
    if Session:GetAttribute("GlobalPaused") == true or Session:GetAttribute("MapChanging") == true then return false end
    local c = getCharacter()
    if not c or c:GetAttribute("Ragdolled") == true or c:GetAttribute("GearMotion") == true or c:GetAttribute("MovementLocked") == true then
