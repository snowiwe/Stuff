local function wheelRequestState(now)
    if now - runtime.wheelStateRequestAt < 1.25 then return end
    runtime.wheelStateRequestAt = now
    pcall(function() SpinWheelEvent:FireServer("State") end)
end

local function autoSpinWheelStep(now)
    if not SETTINGS.autoSpinWheel or LocalPlayer:GetAttribute("InMatch") == true or runtime.wheelSpinning then return end
    wheelRequestState(now)
    local credits = math.floor(tonumber(runtime.wheelCredits) or 0)
    if credits >= SETTINGS.wheelMinimumCredits and now >= runtime.wheelNextAttemptAt then
        runtime.wheelSpinning = true
        runtime.wheelNextAttemptAt = now + SETTINGS.wheelSpinInterval
        runtime.wheelSpinCount += 1
        pcall(function() SpinWheelEvent:FireServer("Spin") end)
        if SETTINGS.wheelAnnounce then Notify("Wheel", "Spin #" .. runtime.wheelSpinCount .. " dispatched", C.Accent) end
        task.delay(1.2, function()
            runtime.wheelSpinning = false
            wheelRequestState(os.clock())
        end)
    end
end

local function mapVoteStep(now)
    if not SETTINGS.autoMapVote or LocalPlayer:GetAttribute("InMatch") == true or now - runtime.mapVoteLastActionAt < 1.5 then return end
    if not MapVoteState or not MapVoteState:IsA("StringValue") then return end
    local ok, state = pcall(function() return HttpService:JSONDecode(MapVoteState.Value) end)
    if ok and type(state) == "table" and state.phase == "Voting" and state.token then
        local targetSlot = SETTINGS.mapVoteSelections[1] or "Map 1"
        local idx = table.find(MAP_VOTE_SLOT_IDS, targetSlot)
        local optId = idx and state.options and state.options[idx] and (state.options[idx].id or state.options[idx].Id)
        if optId then
            runtime.mapVoteLastActionAt = now
            pcall(function() MapVoteEvent:FireServer("Vote", optId, state.token) end)
            Notify("Map Vote", targetSlot .. " vote cast", C.Cyan)
        end
    end
end

SpinWheelEvent.OnClientEvent:Connect(function(kind, payload)
    if kind == "State" and type(payload) == "table" then
        runtime.wheelCredits = tonumber(payload.credits) or 0
        runtime.wheelNextFreeAt = tonumber(payload.nextFreeAt) or 0
        if payload.result or payload.message then runtime.wheelSpinning = false end
    end
end)

JourneyEvent.OnClientEvent:Connect(function(action, data)
    if action == "State" and type(data) == "table" then
        runtime.journeyLoaded = data.loaded == true
        runtime.journeySeasonId = data.seasonId or JourneyConfig.SeasonId
        runtime.journeyTier = tonumber(data.tier) or 1
        runtime.journeyPremium = data.premium == true
        runtime.journeyClaims = type(data.claims) == "table" and data.claims or {}
        runtime.journeyClaimInFlight = false
    end
end)

local function journeyClaimStep(now)
    if not SETTINGS.autoClaimJourneyRewards or LocalPlayer:GetAttribute("InMatch") == true or runtime.journeyClaimInFlight or now < runtime.journeyNextClaimAt then return end
    if not runtime.journeyLoaded then
        pcall(function() JourneyEvent:FireServer("Get") end)
        runtime.journeyNextClaimAt = now + 2.0
        return
    end
    runtime.journeyClaimInFlight = true
    runtime.journeyNextClaimAt = now + 4.0
    pcall(function() JourneyEvent:FireServer("ClaimAll", nil, runtime.journeySeasonId or JourneyConfig.SeasonId) end)
    Notify("Journey", "Claimed seasonal rewards", C.Green)
end

