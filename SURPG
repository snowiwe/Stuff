--[[ 
    BAN OR BE BANNED SCRIPT [v1.5]
    --------------------------------------------------
    - ENGINE: LumaCore UI (Mobile Optimized)
    - NEW: Unban Shop (Buy Unban Tokens)
    - NEW: Ban Shop (Buy Ban Time)
    - FEATURE: Searchable Player List
    - STYLE: Classic Blue
    --------------------------------------------------
]]

-- ============================================================================
-- [1] CONFIGURATION & GLOBALS
-- ============================================================================
local SCALE_FACTOR = 1.0 
local LayoutCounter = 0 

-- State Variables
local SelectedTarget = nil 
local SelectedTimeArg = "Ban5Min" -- Banning Players
local SelectedTimeText = "5 Mins"

local SelectedBanShopArg = "Ban5Min" -- Buying Bans
local SelectedBanShopText = "5 Mins"

local SelectedUnbanShopArg = "Unban1" -- Buying Unbans
local SelectedUnbanShopText = "1 Unban"

-- ============================================================================
-- [2] SERVICES
-- ============================================================================
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local PlayerGui = player:WaitForChild("PlayerGui")

-- Mobile Check
local isMobile = (UserInputService.TouchEnabled and not UserInputService.MouseEnabled)
if isMobile then SCALE_FACTOR = 1.2 end 

-- Dynamic Sizing
local OPEN_SIZE = isMobile and UDim2.new(0, 320, 0.65, 0) or UDim2.new(0, 280, 0, 750) -- Taller for Extra Shop
local CLOSED_SIZE = UDim2.new(0, isMobile and 320 or 280, 0, 45)

-- ============================================================================
-- [3] THEME
-- ============================================================================
local UI_FONT = Enum.Font.SourceSansBold
local UI_FONT_REG = Enum.Font.SourceSans
local THEMES = {
    Classic = {
        base = Color3.fromRGB(35, 40, 55),
        text = Color3.fromRGB(255, 255, 255),
        subtext = Color3.fromRGB(200, 200, 220),
        stroke = Color3.fromRGB(60, 70, 100),
        banner = Color3.fromRGB(60, 75, 140),
        accent = Color3.fromRGB(100, 160, 255),
        success = Color3.fromRGB(100, 220, 120),
        danger = Color3.fromRGB(220, 80, 80),
        search = Color3.fromRGB(45, 50, 65)
    }
}
local CurrentTheme = THEMES.Classic

-- ============================================================================
-- [4] REMOTE HANDLER
-- ============================================================================
local BanRemote = nil
local ShopBanRemote = nil
local ShopUnbanRemote = nil

task.spawn(function()
    pcall(function()
        BanRemote = ReplicatedStorage:WaitForChild("BanRequest", 5)
        ShopBanRemote = ReplicatedStorage:WaitForChild("ShopBuyBan", 5)
        -- ASSUMED NAME: Check if this is correct in your game
        ShopUnbanRemote = ReplicatedStorage:WaitForChild("ShopBuyUnban", 5) 
    end)
    if BanRemote then print("Ban Remote Found!") else warn("Ban Remote NOT Found") end
    if ShopBanRemote then print("Shop Ban Remote Found!") end
    if ShopUnbanRemote then print("Shop Unban Remote Found!") else warn("Shop Unban Remote NOT Found (Check Name)") end
end)

-- ============================================================================
-- [5] UI LIBRARY
-- ============================================================================
if PlayerGui:FindFirstChild("BanUI_v1_5") then PlayerGui["BanUI_v1_5"]:Destroy() end
local gui = Instance.new("ScreenGui")
gui.Name = "BanUI_v1_5"
gui.ResetOnSpawn = false
gui.Parent = PlayerGui
gui.IgnoreGuiInset = true
if SCALE_FACTOR ~= 1 then local s = Instance.new("UIScale", gui); s.Scale = SCALE_FACTOR end

-- Utils
local function doTween(obj, props, time) TweenService:Create(obj, TweenInfo.new(time or 0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play() end
local function GetNextOrder() LayoutCounter = LayoutCounter + 1; return LayoutCounter end

-- Notification
local function Notify(text, color)
    local b = Instance.new("Frame", gui)
    b.Size = UDim2.new(0, 240, 0, 36); b.Position = UDim2.new(0.5, -120, 0.88, 0); b.BackgroundColor3 = color or CurrentTheme.banner
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
    local l = Instance.new("TextLabel", b); l.Size = UDim2.fromScale(1,1); l.BackgroundTransparency=1; l.Text=text; l.TextColor3=CurrentTheme.text; l.Font=UI_FONT; l.TextSize=14
    doTween(b, {Position = UDim2.new(0.5, -120, 0.85, 0)}, 0.3)
    task.delay(2, function() doTween(b, {Position = UDim2.new(0.5, -120, 0.9, 0), BackgroundTransparency = 1}, 0.5); doTween(l, {TextTransparency = 1}, 0.5); task.wait(0.5); b:Destroy() end)
end

-- Main Frames
local MainFrame = Instance.new("Frame", gui)
MainFrame.Size = CLOSED_SIZE; MainFrame.Position = UDim2.new(0.5, -(CLOSED_SIZE.X.Offset/2), 0.4, 0); MainFrame.BackgroundColor3 = CurrentTheme.base; MainFrame.ClipsDescendants = true
Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 14); local MainStroke = Instance.new("UIStroke", MainFrame); MainStroke.Color = CurrentTheme.stroke; MainStroke.Thickness = 2

local TopBar = Instance.new("Frame", MainFrame); TopBar.Size = UDim2.new(1,0,0,45); TopBar.BackgroundTransparency = 1
local Title = Instance.new("TextLabel", TopBar); Title.Text = "Ban Or Be Banned"; Title.Size = UDim2.fromScale(1,1); Title.BackgroundTransparency=1; Title.TextColor3 = CurrentTheme.text; Title.Font = UI_FONT; Title.TextSize = 18
local MinBtn = Instance.new("TextButton", TopBar); MinBtn.Text = "+"; MinBtn.Size = UDim2.new(0,45,1,0); MinBtn.Position = UDim2.new(1,-45,0,0); MinBtn.BackgroundTransparency=1; MinBtn.TextColor3 = CurrentTheme.subtext; MinBtn.Font = UI_FONT; MinBtn.TextSize = 24

-- Logic
local Minimized = true
MinBtn.MouseButton1Click:Connect(function() Minimized = not Minimized; doTween(MainFrame, {Size = Minimized and CLOSED_SIZE or OPEN_SIZE}); MinBtn.Text = Minimized and "+" or "-" end)

-- Draggable
local dragging, dragInput, dragStart, startPos
TopBar.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true; dragStart = input.Position; startPos = MainFrame.Position; input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end) end end)
TopBar.InputChanged:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end end)
UserInputService.InputChanged:Connect(function(input) if input == dragInput and dragging then local delta = input.Position - dragStart; MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y) end end)

-- Content
local Content = Instance.new("ScrollingFrame", MainFrame); Content.Size = UDim2.new(1,0,1,-45); Content.Position = UDim2.new(0,0,0,45); Content.BackgroundTransparency = 1; Content.ScrollBarThickness = 3; Content.ScrollBarImageColor3 = CurrentTheme.accent
local UIList = Instance.new("UIListLayout", Content); UIList.HorizontalAlignment = Enum.HorizontalAlignment.Center; UIList.Padding = UDim.new(0, 6); UIList.SortOrder = Enum.SortOrder.LayoutOrder
local UIPad = Instance.new("UIPadding", Content); UIPad.PaddingTop = UDim.new(0, 5); UIPad.PaddingBottom = UDim.new(0, 10)

-- Builders
local function CreateSection(text)
    local l = Instance.new("TextLabel", Content); l.Text = text; l.Size = UDim2.new(1, -20, 0, 25); l.BackgroundTransparency = 1; l.TextColor3 = CurrentTheme.accent; l.Font = UI_FONT; l.TextSize = 12; l.TextXAlignment = Enum.TextXAlignment.Left; l.LayoutOrder = GetNextOrder()
end

local function CreateButton(text, callback)
    local b = Instance.new("TextButton", Content); b.Size = UDim2.new(1, -12, 0, 42); b.BackgroundColor3 = Color3.fromRGB(45, 50, 65); b.Text = ""; b.LayoutOrder = GetNextOrder()
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8); local s = Instance.new("UIStroke", b); s.Color = CurrentTheme.stroke; s.Thickness = 1
    local t = Instance.new("TextLabel", b); t.Text = text; t.Size = UDim2.fromScale(1, 1); t.BackgroundTransparency = 1; t.TextColor3 = CurrentTheme.text; t.Font = UI_FONT; t.TextSize = 14
    b.MouseButton1Click:Connect(function()
        doTween(b, {Size = UDim2.new(1, -16, 0, 40)}, 0.1); task.delay(0.1, function() doTween(b, {Size = UDim2.new(1, -12, 0, 42)}, 0.1) end)
        if callback(s) then doTween(s, {Color = CurrentTheme.success}, 0.3); task.delay(0.5, function() doTween(s, {Color = CurrentTheme.stroke}, 0.5) end)
        else doTween(s, {Color = CurrentTheme.danger}, 0.3); task.delay(0.5, function() doTween(s, {Color = CurrentTheme.stroke}, 0.5) end) end
    end)
    return b
end

-- [LIVE PLAYER DROPDOWN + SEARCH]
local function CreateSearchablePlayerDropdown(callback)
    local Frame = Instance.new("Frame", Content); Frame.Size = UDim2.new(1, -12, 0, 42); Frame.BackgroundColor3 = Color3.fromRGB(45, 50, 65); Frame.ClipsDescendants = true; Frame.LayoutOrder = GetNextOrder()
    Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 8); local s = Instance.new("UIStroke", Frame); s.Color = CurrentTheme.stroke; s.Thickness = 1
    local MainBtn = Instance.new("TextButton", Frame); MainBtn.Size = UDim2.new(1, 0, 0, 42); MainBtn.BackgroundTransparency = 1; MainBtn.Text = ""
    local TitleL = Instance.new("TextLabel", MainBtn); TitleL.Text = "Select Target: None"; TitleL.Size = UDim2.new(1, -30, 1, 0); TitleL.Position = UDim2.new(0, 15, 0, 0); TitleL.BackgroundTransparency = 1; TitleL.TextColor3 = CurrentTheme.text; TitleL.Font = UI_FONT; TitleL.TextSize = 14; TitleL.TextXAlignment = Enum.TextXAlignment.Left
    local Arrow = Instance.new("TextLabel", MainBtn); Arrow.Text = "v"; Arrow.Size = UDim2.new(0, 30, 1, 0); Arrow.Position = UDim2.new(1, -30, 0, 0); Arrow.BackgroundTransparency = 1; Arrow.TextColor3 = CurrentTheme.subtext; Arrow.Font = UI_FONT; Arrow.TextSize = 14
    local SearchContainer = Instance.new("Frame", Frame); SearchContainer.Size = UDim2.new(1, -10, 0, 35); SearchContainer.Position = UDim2.new(0, 5, 0, 42); SearchContainer.BackgroundTransparency = 1; SearchContainer.Visible = false
    local SearchBox = Instance.new("TextBox", SearchContainer); SearchBox.Size = UDim2.new(1, 0, 1, 0); SearchBox.BackgroundColor3 = CurrentTheme.search; SearchBox.PlaceholderText = "Type to search..."; SearchBox.Text = ""; SearchBox.TextColor3 = CurrentTheme.text; SearchBox.PlaceholderColor3 = CurrentTheme.subtext; SearchBox.Font = UI_FONT_REG; SearchBox.TextSize = 14; Instance.new("UICorner", SearchBox).CornerRadius = UDim.new(0, 6)
    local ItemContainer = Instance.new("ScrollingFrame", Frame); ItemContainer.Size = UDim2.new(1, 0, 0, 0); ItemContainer.Position = UDim2.new(0, 0, 0, 80); ItemContainer.BackgroundTransparency = 1; ItemContainer.LayoutOrder = 2; ItemContainer.ScrollBarThickness = 2
    local IList = Instance.new("UIListLayout", ItemContainer); IList.Padding = UDim.new(0, 2); IList.HorizontalAlignment = Enum.HorizontalAlignment.Center
    
    local isOpen = false
    local function UpdateList(filter)
        filter = filter and filter:lower() or ""
        for _, c in ipairs(ItemContainer:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
        local pList = Players:GetPlayers(); local count = 0
        for _, p in ipairs(pList) do
            if p ~= player then
                if filter == "" or string.find(p.Name:lower(), filter) or string.find(p.DisplayName:lower(), filter) then
                    count = count + 1
                    local b = Instance.new("TextButton", ItemContainer); b.Size = UDim2.new(0.95, 0, 0, 30); b.BackgroundColor3 = Color3.fromRGB(35, 40, 55); b.Text = p.Name; b.TextColor3 = CurrentTheme.subtext; b.Font = UI_FONT; b.TextSize = 13; Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
                    b.MouseButton1Click:Connect(function() callback(p.Name); TitleL.Text = "Target: " .. p.Name; isOpen = false; Arrow.Text = "v"; SearchContainer.Visible = false; doTween(Frame, {Size = UDim2.new(1, -12, 0, 42)}, 0.3) end)
                end
            end
        end
        ItemContainer.CanvasSize = UDim2.new(0, 0, 0, count * 32); local h = math.min(count * 32, 150)
        if isOpen then ItemContainer.Position = UDim2.new(0, 0, 0, 82); doTween(ItemContainer, {Size = UDim2.new(1, 0, 0, h)}); doTween(Frame, {Size = UDim2.new(1, -12, 0, 42 + 40 + h + 5)}) end
    end
    MainBtn.MouseButton1Click:Connect(function() isOpen = not isOpen; Arrow.Text = isOpen and "^" or "v"; SearchContainer.Visible = isOpen; if isOpen then SearchBox.Text = ""; UpdateList("") else doTween(Frame, {Size = UDim2.new(1, -12, 0, 42)}) end end)
    SearchBox:GetPropertyChangedSignal("Text"):Connect(function() if isOpen then UpdateList(SearchBox.Text) end end)
    Players.PlayerAdded:Connect(function() if isOpen then UpdateList(SearchBox.Text) end end)
    Players.PlayerRemoving:Connect(function(p) if isOpen then UpdateList(SearchBox.Text) end; if SelectedTarget == p.Name then SelectedTarget = nil; TitleL.Text = "Select Target: None"; Notify("Target Left Game!", CurrentTheme.danger) end end)
end

-- [GENERIC DROPDOWN]
local function CreateDropdown(title, default, options, callback)
    local Frame = Instance.new("Frame", Content); Frame.Size = UDim2.new(1, -12, 0, 42); Frame.BackgroundColor3 = Color3.fromRGB(45, 50, 65); Frame.ClipsDescendants = true; Frame.LayoutOrder = GetNextOrder()
    Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 8); local s = Instance.new("UIStroke", Frame); s.Color = CurrentTheme.stroke; s.Thickness = 1
    local MainBtn = Instance.new("TextButton", Frame); MainBtn.Size = UDim2.new(1, 0, 0, 42); MainBtn.BackgroundTransparency = 1; MainBtn.Text = ""
    local TitleL = Instance.new("TextLabel", MainBtn); TitleL.Text = title .. ": " .. default; TitleL.Size = UDim2.new(1, -30, 1, 0); TitleL.Position = UDim2.new(0, 15, 0, 0); TitleL.BackgroundTransparency = 1; TitleL.TextColor3 = CurrentTheme.text; TitleL.Font = UI_FONT; TitleL.TextSize = 14; TitleL.TextXAlignment = Enum.TextXAlignment.Left
    local Arrow = Instance.new("TextLabel", MainBtn); Arrow.Text = "v"; Arrow.Size = UDim2.new(0, 30, 1, 0); Arrow.Position = UDim2.new(1, -30, 0, 0); Arrow.BackgroundTransparency = 1; Arrow.TextColor3 = CurrentTheme.subtext; Arrow.Font = UI_FONT; Arrow.TextSize = 14
    local ItemList = Instance.new("UIListLayout", Frame); ItemList.Padding = UDim.new(0, 2); ItemList.HorizontalAlignment = Enum.HorizontalAlignment.Center; ItemList.SortOrder = Enum.SortOrder.LayoutOrder
    local Pad = Instance.new("Frame", Frame); Pad.Size = UDim2.new(1, 0, 0, 42); Pad.BackgroundTransparency = 1; Pad.LayoutOrder = 0
    
    local isOpen = false
    MainBtn.MouseButton1Click:Connect(function() isOpen = not isOpen; Arrow.Text = isOpen and "^" or "v"; doTween(Frame, {Size = UDim2.new(1, -12, 0, isOpen and (42 + (#options * 32) + 5) or 42)}, 0.3) end)
    
    for i, opt in ipairs(options) do
        local OptBtn = Instance.new("TextButton", Frame); OptBtn.Size = UDim2.new(0.95, 0, 0, 30); OptBtn.BackgroundColor3 = Color3.fromRGB(35, 40, 55); OptBtn.Text = opt.txt; OptBtn.TextColor3 = CurrentTheme.subtext; OptBtn.Font = UI_FONT; OptBtn.TextSize = 13; OptBtn.LayoutOrder = i; Instance.new("UICorner", OptBtn).CornerRadius = UDim.new(0, 6)
        OptBtn.MouseButton1Click:Connect(function() callback(opt); TitleL.Text = title .. ": " .. opt.txt; isOpen = false; Arrow.Text = "v"; doTween(Frame, {Size = UDim2.new(1, -12, 0, 42)}, 0.3) end)
    end
end

-- ============================================================================
-- [6] ACTIONS
-- ============================================================================

-- :: BAN PLAYER SECTION ::
CreateSection("BAN PLAYER")

CreateSearchablePlayerDropdown(function(name) SelectedTarget = name end)

local banTimes = {
    {txt="5 Mins", val="Ban5Min"}, {txt="15 Mins", val="Ban15Min"},
    {txt="30 Mins", val="Ban30Min"}, {txt="1 Hour", val="Ban1Hour"},
    {txt="1 Day", val="Ban1Day"}, {txt="30 Days", val="Ban30Days"},
    {txt="365 Days", val="Ban365Days"}
}

CreateDropdown("Ban Duration", "5 Mins", banTimes, function(option)
    SelectedTimeArg = option.val
    SelectedTimeText = option.txt
end)

CreateButton("Ban Player Request", function(btnStroke)
    if not SelectedTarget then Notify("Select a player!", CurrentTheme.danger); return false end
    if BanRemote then
        BanRemote:FireServer(unpack({ SelectedTarget, SelectedTimeArg }))
        Notify("Banning: " .. SelectedTarget, CurrentTheme.danger)
        return true
    else Notify("Ban Remote Missing", CurrentTheme.danger); return false end
end)

-- :: BAN SHOP SECTION ::
CreateSection("BAN SHOP")

CreateDropdown("Buy Ban Time", "5 Mins", banTimes, function(option)
    SelectedBanShopArg = option.val
    SelectedBanShopText = option.txt
end)

CreateButton("Purchase Ban", function(btnStroke)
    if ShopBanRemote then
        ShopBanRemote:FireServer(unpack({ SelectedBanShopArg }))
        Notify("Bought: " .. SelectedBanShopText, CurrentTheme.success)
        return true
    else Notify("Shop Remote Missing", CurrentTheme.danger); return false end
end)

