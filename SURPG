--[[ 
    SURPG SCRIPT [UPDATE 2.7]
    --------------------------------------------------
    - FORM LOGIC: Select Form -> Click Transform Toggle
    - EMERALD LOGIC: Select Color -> Click Teleport Button
    - ENGINE: LumaCore (Mobile Ready & Optimized)
    --------------------------------------------------
]]

-- ============================================================================
-- [1] CONFIGURATION & GLOBALS
-- ============================================================================
local SCALE_FACTOR = 1.0 
local LayoutCounter = 0 

-- State Variables
local SelectedForm = "Super" -- Default
local SelectedEmerald = "White"
local EmeraldColor = Color3.new(1,1,1)
local TailsLoop = false

-- ============================================================================
-- [2] SERVICES & INITIALIZATION
-- ============================================================================
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local PlayerGui = player:WaitForChild("PlayerGui")

-- Mobile Check
local isMobile = (UserInputService.TouchEnabled and not UserInputService.MouseEnabled)
if isMobile then SCALE_FACTOR = 1.2 end 

local OPEN_SIZE = isMobile and UDim2.new(0, 320, 0.65, 0) or UDim2.new(0, 280, 0, 600)
local CLOSED_SIZE = UDim2.new(0, isMobile and 320 or 280, 0, 45)

-- ============================================================================
-- [3] THEME & STYLING
-- ============================================================================
local UI_FONT = Enum.Font.SourceSansBold
local THEMES = {
	Classic = {
		base = Color3.fromRGB(35, 40, 55),
		text = Color3.fromRGB(255, 255, 255),
		subtext = Color3.fromRGB(200, 200, 220),
		stroke = Color3.fromRGB(60, 70, 100),
		banner = Color3.fromRGB(60, 75, 140),
		accent = Color3.fromRGB(100, 160, 255),
		success = Color3.fromRGB(100, 220, 120),
		danger = Color3.fromRGB(220, 80, 80),
	}
}
local CurrentTheme = THEMES.Classic

-- ============================================================================
-- [4] REMOTE HANDLER (Safe Loading)
-- ============================================================================
local Remotes = { Quest = nil, Chaos = nil, Replica = nil, Transform = nil }

task.spawn(function()
	pcall(function() Remotes.Quest = ReplicatedStorage:WaitForChild("Events", 5):WaitForChild("Quest", 5) end)
	pcall(function() Remotes.Chaos = ReplicatedStorage:WaitForChild("Remotes", 5):WaitForChild("ChaosControlUsed", 5) end)
	pcall(function() Remotes.Replica = ReplicatedStorage:WaitForChild("RemoteEvents", 5):WaitForChild("ReplicaSignal", 5) end)
	pcall(function() Remotes.Transform = ReplicatedStorage:WaitForChild("Remotes", 5):WaitForChild("TransformPlayer", 5) end)
	print("SURPG: Remotes Loaded")
end)

-- ============================================================================
-- [5] UI LIBRARY (Builders)
-- ============================================================================
if PlayerGui:FindFirstChild("SURPG_UI_v2_7") then PlayerGui["SURPG_UI_v2_7"]:Destroy() end
local gui = Instance.new("ScreenGui")
gui.Name = "SURPG_UI_v2_7"
gui.ResetOnSpawn = false
gui.Parent = PlayerGui
gui.IgnoreGuiInset = true
if SCALE_FACTOR ~= 1 then local s = Instance.new("UIScale", gui); s.Scale = SCALE_FACTOR end

-- > Tweens
local function doTween(obj, props, time)
	TweenService:Create(obj, TweenInfo.new(time or 0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

-- > Sorting
local function GetNextOrder() LayoutCounter = LayoutCounter + 1; return LayoutCounter end

-- > Notifications
local function Notify(text, color)
	local b = Instance.new("Frame", gui)
	b.Size = UDim2.new(0, 240, 0, 36); b.Position = UDim2.new(0.5, -120, 0.88, 0); b.BackgroundColor3 = color or CurrentTheme.banner
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
	local l = Instance.new("TextLabel", b); l.Size = UDim2.fromScale(1,1); l.BackgroundTransparency=1; l.Text=text; l.TextColor3=CurrentTheme.text; l.Font=UI_FONT; l.TextSize=14
	doTween(b, {Position = UDim2.new(0.5, -120, 0.85, 0)}, 0.3)
	task.delay(2, function() doTween(b, {Position = UDim2.new(0.5, -120, 0.9, 0), BackgroundTransparency = 1}, 0.5); doTween(l, {TextTransparency = 1}, 0.5); task.wait(0.5); b:Destroy() end)
end

-- > Main Frame
local MainFrame = Instance.new("Frame", gui)
MainFrame.Size = CLOSED_SIZE; MainFrame.Position = UDim2.new(0.5, -(CLOSED_SIZE.X.Offset/2), 0.4, 0); MainFrame.BackgroundColor3 = CurrentTheme.base; MainFrame.ClipsDescendants = true
Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 14); local MainStroke = Instance.new("UIStroke", MainFrame); MainStroke.Color = CurrentTheme.stroke; MainStroke.Thickness = 2

-- > Top Bar
local TopBar = Instance.new("Frame", MainFrame); TopBar.Size = UDim2.new(1,0,0,45); TopBar.BackgroundTransparency = 1
local Title = Instance.new("TextLabel", TopBar); Title.Text = "[Update 2.7] SURPG"; Title.Size = UDim2.fromScale(1,1); Title.BackgroundTransparency=1; Title.TextColor3 = CurrentTheme.text; Title.Font = UI_FONT; Title.TextSize = 18
local MinBtn = Instance.new("TextButton", TopBar); MinBtn.Text = "+"; MinBtn.Size = UDim2.new(0,45,1,0); MinBtn.Position = UDim2.new(1,-45,0,0); MinBtn.BackgroundTransparency=1; MinBtn.TextColor3 = CurrentTheme.subtext; MinBtn.Font = UI_FONT; MinBtn.TextSize = 24

-- > Logic
local Minimized = true
MinBtn.MouseButton1Click:Connect(function() Minimized = not Minimized; doTween(MainFrame, {Size = Minimized and CLOSED_SIZE or OPEN_SIZE}); MinBtn.Text = Minimized and "+" or "-" end)

-- > Draggable
local dragging, dragInput, dragStart, startPos
TopBar.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true; dragStart = input.Position; startPos = MainFrame.Position; input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end) end end)
TopBar.InputChanged:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end end)
UserInputService.InputChanged:Connect(function(input) if input == dragInput and dragging then local delta = input.Position - dragStart; MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y) end end)

-- > Content Area
local Content = Instance.new("ScrollingFrame", MainFrame); Content.Size = UDim2.new(1,0,1,-45); Content.Position = UDim2.new(0,0,0,45); Content.BackgroundTransparency = 1; Content.ScrollBarThickness = 3; Content.ScrollBarImageColor3 = CurrentTheme.accent
local UIList = Instance.new("UIListLayout", Content); UIList.HorizontalAlignment = Enum.HorizontalAlignment.Center; UIList.Padding = UDim.new(0, 6); UIList.SortOrder = Enum.SortOrder.LayoutOrder
local UIPad = Instance.new("UIPadding", Content); UIPad.PaddingTop = UDim.new(0, 5); UIPad.PaddingBottom = UDim.new(0, 10)

-- > BUILDER: Section Header
local function CreateSection(text)
	local l = Instance.new("TextLabel", Content); l.Text = text; l.Size = UDim2.new(1, -20, 0, 25); l.BackgroundTransparency = 1; l.TextColor3 = CurrentTheme.accent; l.Font = UI_FONT; l.TextSize = 12; l.TextXAlignment = Enum.TextXAlignment.Left; l.LayoutOrder = GetNextOrder()
end

-- > BUILDER: Button
local function CreateButton(text, callback)
	local b = Instance.new("TextButton", Content); b.Size = UDim2.new(1, -12, 0, 42); b.BackgroundColor3 = Color3.fromRGB(45, 50, 65); b.Text = ""; b.LayoutOrder = GetNextOrder()
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8); local s = Instance.new("UIStroke", b); s.Color = CurrentTheme.stroke; s.Thickness = 1
	local t = Instance.new("TextLabel", b); t.Text = text; t.Size = UDim2.fromScale(1, 1); t.BackgroundTransparency = 1; t.TextColor3 = CurrentTheme.text; t.Font = UI_FONT; t.TextSize = 14
	b.MouseButton1Click:Connect(function()
		doTween(b, {Size = UDim2.new(1, -16, 0, 40)}, 0.1); task.delay(0.1, function() doTween(b, {Size = UDim2.new(1, -12, 0, 42)}, 0.1) end)
		if callback(s) then doTween(s, {Color = CurrentTheme.success}, 0.3); task.delay(0.5, function() doTween(s, {Color = CurrentTheme.stroke}, 0.5) end)
		else doTween(s, {Color = CurrentTheme.danger}, 0.3); task.delay(0.5, function() doTween(s, {Color = CurrentTheme.stroke}, 0.5) end) end
	end)
	return b
end

-- > BUILDER: Toggle
local function CreateToggle(text, callback)
	local b = Instance.new("TextButton", Content); b.Size = UDim2.new(1, -12, 0, 42); b.BackgroundColor3 = Color3.fromRGB(45, 50, 65); b.Text = ""; b.LayoutOrder = GetNextOrder()
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8); local s = Instance.new("UIStroke", b); s.Color = CurrentTheme.stroke; s.Thickness = 1
	local t = Instance.new("TextLabel", b); t.Text = text; t.Size = UDim2.new(1, -40, 1, 0); t.Position = UDim2.new(0, 15, 0, 0); t.BackgroundTransparency = 1; t.TextColor3 = CurrentTheme.text; t.Font = UI_FONT; t.TextSize = 14; t.TextXAlignment = Enum.TextXAlignment.Left
	local ind = Instance.new("Frame", b); ind.Size = UDim2.new(0, 16, 0, 16); ind.Position = UDim2.new(1, -25, 0.5, 0); ind.AnchorPoint = Vector2.new(0, 0.5); ind.BackgroundColor3 = CurrentTheme.danger; Instance.new("UICorner", ind).CornerRadius = UDim.new(0, 4)
	local on = false
	b.MouseButton1Click:Connect(function() on = not on; callback(on); doTween(ind, {BackgroundColor3 = on and CurrentTheme.success or CurrentTheme.danger}, 0.2); doTween(s, {Color = on and CurrentTheme.success or CurrentTheme.stroke}, 0.3) end)
	return b
end

-- > BUILDER: Dropdown
local function CreateDropdown(title, options, callback)
	local Frame = Instance.new("Frame", Content); Frame.Size = UDim2.new(1, -12, 0, 42); Frame.BackgroundColor3 = Color3.fromRGB(45, 50, 65); Frame.ClipsDescendants = true; Frame.LayoutOrder = GetNextOrder()
	Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 8); local s = Instance.new("UIStroke", Frame); s.Color = CurrentTheme.stroke; s.Thickness = 1
	local MainBtn = Instance.new("TextButton", Frame); MainBtn.Size = UDim2.new(1, 0, 0, 42); MainBtn.BackgroundTransparency = 1; MainBtn.Text = ""
	local TitleL = Instance.new("TextLabel", MainBtn); TitleL.Text = title .. ": " .. (options[1].name or "Select"); TitleL.Size = UDim2.new(1, -30, 1, 0); TitleL.Position = UDim2.new(0, 15, 0, 0); TitleL.BackgroundTransparency = 1; TitleL.TextColor3 = CurrentTheme.text; TitleL.Font = UI_FONT; TitleL.TextSize = 14; TitleL.TextXAlignment = Enum.TextXAlignment.Left
	local Arrow = Instance.new("TextLabel", MainBtn); Arrow.Text = "v"; Arrow.Size = UDim2.new(0, 30, 1, 0); Arrow.Position = UDim2.new(1, -30, 0, 0); Arrow.BackgroundTransparency = 1; Arrow.TextColor3 = CurrentTheme.subtext; Arrow.Font = UI_FONT; Arrow.TextSize = 14
	local ItemList = Instance.new("UIListLayout", Frame); ItemList.Padding = UDim.new(0, 2); ItemList.HorizontalAlignment = Enum.HorizontalAlignment.Center; ItemList.SortOrder = Enum.SortOrder.LayoutOrder
	local Pad = Instance.new("Frame", Frame); Pad.Size = UDim2.new(1, 0, 0, 42); Pad.BackgroundTransparency = 1; Pad.LayoutOrder = 0
	local isOpen = false
	MainBtn.MouseButton1Click:Connect(function() isOpen = not isOpen; Arrow.Text = isOpen and "^" or "v"; doTween(Frame, {Size = UDim2.new(1, -12, 0, isOpen and (42 + (#options * 32) + 5) or 42)}, 0.3) end)

	for i, opt in ipairs(options) do
		local OptBtn = Instance.new("TextButton", Frame); OptBtn.Size = UDim2.new(0.95, 0, 0, 30); OptBtn.BackgroundColor3 = Color3.fromRGB(35, 40, 55); OptBtn.Text = opt.name; OptBtn.TextColor3 = CurrentTheme.subtext; OptBtn.Font = UI_FONT; OptBtn.TextSize = 13; OptBtn.LayoutOrder = i; Instance.new("UICorner", OptBtn).CornerRadius = UDim.new(0, 6)
		if opt.col then local dot = Instance.new("Frame", OptBtn); dot.Size = UDim2.new(0, 10, 0, 10); dot.Position = UDim2.new(0, 10, 0.5, 0); dot.AnchorPoint = Vector2.new(0, 0.5); dot.BackgroundColor3 = opt.col; Instance.new("UICorner", dot).CornerRadius = UDim.new(1,0) end
		OptBtn.MouseButton1Click:Connect(function() callback(opt); TitleL.Text = title .. ": " .. opt.name; isOpen = false; Arrow.Text = "v"; doTween(Frame, {Size = UDim2.new(1, -12, 0, 42)}, 0.3) end)
	end
end

-- ============================================================================
-- [6] FEATURES & LOGIC
-- ============================================================================

-- :: QUESTS ::
CreateSection("QUESTS")
CreateToggle("Auto Tails Quest", function(state)
	TailsLoop = state
	if state then
		Notify("Tails Loop: ENABLED", CurrentTheme.success)
		task.spawn(function()
			while TailsLoop and gui.Parent do
				if Remotes.Quest then Remotes.Quest:FireServer(unpack({ "CompletedToNPC", "Tails", "ScrapSearch", "Tails" })) end
				task.wait(0.5)
			end
		end)
	else
		Notify("Tails Loop: DISABLED", CurrentTheme.danger)
	end
end)

-- :: FORMS ::
CreateSection("FORMS")

local forms = { {name="Super"}, {name="Dark"}, {name="FakeHyper"} }

CreateDropdown("Select Form", forms, function(choice)
	SelectedForm = choice.name
	-- Automatically set the form variable on server when selected
	if Remotes.Replica then
		Remotes.Replica:FireServer(unpack({ 1606, "SetChosenForm", SelectedForm }))
		Notify("Selected: " .. SelectedForm, CurrentTheme.accent)
	end
end)

CreateToggle("Transform Toggle", function(state)
	if Remotes.Transform then
		Remotes.Transform:FireServer()
		Notify(state and "Transforming..." or "Reverting...", state and CurrentTheme.success or CurrentTheme.danger)
	else
		Notify("Remote Missing", CurrentTheme.danger)
	end
end)

-- :: CHAOS EMERALDS ::
CreateSection("CHAOS EMERALDS")

local emeraldData = {
	{name = "White", col = Color3.new(1,1,1)},
	{name = "Red", col = Color3.fromRGB(255,50,50)},
	{name = "Blue", col = Color3.fromRGB(50,50,255)},
	{name = "Yellow", col = Color3.fromRGB(255,255,50)},
	{name = "Green", col = Color3.fromRGB(50,255,50)},
	{name = "Cyan", col = Color3.fromRGB(50,255,255)},
	{name = "Purple", col = Color3.fromRGB(170,0,170)}
}

CreateDropdown("Select Emerald", emeraldData, function(selection)
	SelectedEmerald = selection.name
	EmeraldColor = selection.col
end)

CreateButton("Teleport to Emerald", function(btnStroke)
	if Remotes.Chaos then
		Remotes.Chaos:FireServer(SelectedEmerald)
		Notify("Warped to " .. SelectedEmerald, EmeraldColor)

		-- Special Visual: Button border changes to Emerald color
		doTween(btnStroke, {Color = EmeraldColor}, 0.3)
		task.delay(0.8, function() doTween(btnStroke, {Color = CurrentTheme.stroke}, 0.5) end)
		return true
	else
		Notify("Remote Missing", CurrentTheme.danger)
		return false
	end
end)

-- :: INTERFACE ::
CreateSection("INTERFACE")
CreateButton("Destroy UI", function() TailsLoop = false; gui:Destroy(); return true end)

-- ============================================================================
-- [7] STARTUP ANIMATION
-- ============================================================================
local function PlayIntro()
	local Intro = Instance.new("Frame", gui); Intro.Size = UDim2.fromScale(1,1); Intro.BackgroundColor3 = Color3.fromRGB(20,20,25); Intro.ZIndex = 100
	local Lbl = Instance.new("TextLabel", Intro); Lbl.Text = "SURPG v2.7"; Lbl.Font = Enum.Font.GothamBlack; Lbl.TextSize = 0; Lbl.TextColor3 = CurrentTheme.accent; Lbl.Position = UDim2.fromScale(0.5, 0.5); Lbl.AnchorPoint = Vector2.new(0.5, 0.5); Lbl.BackgroundTransparency = 1
	doTween(Lbl, {TextSize = 45}, 0.5); task.wait(1.2); doTween(Intro, {BackgroundTransparency = 1}, 0.5); doTween(Lbl, {TextTransparency = 1}, 0.5); task.wait(0.5); Intro:Destroy()
end

PlayIntro()
task.delay(1.8, function() doTween(MainFrame, {Size = OPEN_SIZE}) end)
