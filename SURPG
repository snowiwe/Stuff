-- // 5. UI SETUP //
if PlayerGui:FindFirstChild("SURPG_UI_v2.4") then PlayerGui["SURPG_UI_v2.4"]:Destroy() end
local gui = Instance.new("ScreenGui")
gui.Name = "SURPG_UI_v2.4"
gui.ResetOnSpawn = false
gui.Parent = PlayerGui
gui.IgnoreGuiInset = true

if isMobile then
	local s = Instance.new("UIScale", gui)
	s.Scale = 1.2
end

-- // 6. ANIMATION & UTILS //
local function doTween(obj, props, time)
	TweenService:Create(obj, TweenInfo.new(time or 0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

local function Notify(text, color)
	local b = Instance.new("Frame", gui)
	b.Size = UDim2.new(0, 220, 0, 34)
	b.Position = UDim2.new(0.5, -110, 0.9, 0)
	b.BackgroundColor3 = color or CurrentTheme.banner
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)

	local l = Instance.new("TextLabel", b)
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = 1
	l.Text = text
	l.TextColor3 = CurrentTheme.text
	l.Font = UI_FONT
	l.TextSize = 14

	doTween(b, {Position = UDim2.new(0.5, -110, 0.85, 0)}, 0.3)
	task.delay(2, function()
		doTween(b, {Position = UDim2.new(0.5, -110, 0.9, 0), BackgroundTransparency = 1}, 0.5)
		doTween(l, {TextTransparency = 1}, 0.5)
		task.wait(0.5)
		b:Destroy()
	end)
end

-- // 7. MAIN FRAME & DRAGGING //
local MainFrame = Instance.new("Frame", gui)
MainFrame.Size = CLOSED_SIZE
MainFrame.Position = UDim2.new(0.5, -140, 0.4, 0)
MainFrame.BackgroundColor3 = CurrentTheme.base
MainFrame.ClipsDescendants = true
Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 14)
Instance.new("UIStroke", MainFrame).Color = CurrentTheme.stroke

local TopBar = Instance.new("Frame", MainFrame)
TopBar.Size = UDim2.new(1, 0, 0, 40)
TopBar.BackgroundTransparency = 1

local Title = Instance.new("TextLabel", TopBar)
Title.Text = "[Update 2.4] SURPG"
Title.Size = UDim2.fromScale(1, 1)
Title.BackgroundTransparency = 1
Title.TextColor3 = CurrentTheme.text
Title.Font = UI_FONT
Title.TextSize = 18

local MinBtn = Instance.new("TextButton", TopBar)
MinBtn.Text = "+"
MinBtn.Size = UDim2.new(0, 40, 1, 0)
MinBtn.Position = UDim2.new(1, -40, 0, 0)
MinBtn.BackgroundTransparency = 1
MinBtn.TextColor3 = CurrentTheme.subtext
MinBtn.Font = UI_FONT
MinBtn.TextSize = 24

-- Draggable Logic
local dragging, dragInput, dragStart, startPos
TopBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = MainFrame.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then dragging = false end
		end)
	end
end)
TopBar.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)
UserInputService.InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		local delta = input.Position - dragStart
		MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)

-- Minimize Logic
local Minimized = true
local function ToggleUI()
	Minimized = not Minimized
	doTween(MainFrame, {Size = Minimized and CLOSED_SIZE or OPEN_SIZE})
	MinBtn.Text = Minimized and "+" or "-"
end
MinBtn.MouseButton1Click:Connect(ToggleUI)

