	{name = "White", col = Color3.new(1,1,1)},
	{name = "Red", col = Color3.fromRGB(255,50,50)},
	{name = "Blue", col = Color3.fromRGB(50,50,255)},
	{name = "Yellow", col = Color3.fromRGB(255,255,50)},
	{name = "Green", col = Color3.fromRGB(50,255,50)},
	{name = "Cyan", col = Color3.fromRGB(50,255,255)},
	{name = "Purple", col = Color3.fromRGB(170,0,170)}
}

for _, gem in ipairs(emeralds) do
