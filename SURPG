    else Notify("Unban Shop Remote Missing", CurrentTheme.danger); return false end
end)

CreateSection("INTERFACE")
CreateButton("Destroy UI", function() gui:Destroy(); return true end)

-- ============================================================================
-- [7] STARTUP
-- ============================================================================
local function PlayIntro()
    local Intro = Instance.new("Frame", gui); Intro.Size = UDim2.fromScale(1,1); Intro.BackgroundColor3 = Color3.fromRGB(20,20,25); Intro.ZIndex = 100
    local Lbl = Instance.new("TextLabel", Intro); Lbl.Text = "Ban Or Be Banned"; Lbl.Font = Enum.Font.GothamBlack; Lbl.TextSize = 0; Lbl.TextColor3 = CurrentTheme.accent; Lbl.Position = UDim2.fromScale(0.5, 0.5); Lbl.AnchorPoint = Vector2.new(0.5, 0.5); Lbl.BackgroundTransparency = 1
    doTween(Lbl, {TextSize = 40}, 0.5); task.wait(1.2); doTween(Intro, {BackgroundTransparency = 1}, 0.5); doTween(Lbl, {TextTransparency = 1}, 0.5); task.wait(0.5); Intro:Destroy()
end

PlayIntro()
task.delay(1.8, function() doTween(MainFrame, {Size = OPEN_SIZE}) end)
