--[[ 
    SURPG SCRIPT [UPDATE 2.4] - POLISHED & MOBILE READY
    --------------------------------------------------
    - FIXED: Global Variable Errors (SCALE_FACTOR)
    - FIXED: Layout Sorting (Headers stick to sections)
    - MOBILE: Auto-scales for phones/tablets
    - FEATURES: Quests, Forms, Emeralds
    --------------------------------------------------
]]

-- // 1. GLOBAL VARIABLES (Must be at the top) //
local SCALE_FACTOR = 1.0 -- Default Scale
local LockedButtons = {} -- Fixes 'LockedButtons' error
local LayoutCounter = 0  -- Fixes Sorting Issues

-- // 2. SERVICES //
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local PlayerGui = player:WaitForChild("PlayerGui")

-- // 3. CONFIGURATION & MOBILE CHECK //
local isMobile = (UserInputService.TouchEnabled and not UserInputService.MouseEnabled)

if isMobile then 
	SCALE_FACTOR = 1.2 -- Make UI bigger on mobile
end 

-- Dynamic Sizing
local OPEN_SIZE = isMobile and UDim2.new(0, 320, 0.60, 0) or UDim2.new(0, 280, 0, 600)
local CLOSED_SIZE = UDim2.new(0, isMobile and 320 or 280, 0, 45)

-- // 4. THEME //
local UI_FONT = Enum.Font.SourceSansBold
local THEMES = {
	Classic = {
		base = Color3.fromRGB(35, 40, 55), -- Darker, cleaner base
		text = Color3.fromRGB(255, 255, 255),
		subtext = Color3.fromRGB(200, 200, 220),
		stroke = Color3.fromRGB(60, 70, 100),
		banner = Color3.fromRGB(60, 75, 140),
		accent = Color3.fromRGB(100, 160, 255),
		success = Color3.fromRGB(100, 220, 120),
		danger = Color3.fromRGB(220, 80, 80),
	}
}
local CurrentTheme = THEMES.Classic

-- // 5. REMOTE HANDLER //
local Remotes = {
	Quest = nil,
	Chaos = nil,
	Replica = nil
}

task.spawn(function()
	pcall(function() Remotes.Quest = ReplicatedStorage:WaitForChild("Events", 5):WaitForChild("Quest", 5) end)
	pcall(function() Remotes.Chaos = ReplicatedStorage:WaitForChild("Remotes", 5):WaitForChild("ChaosControlUsed", 5) end)
	pcall(function() Remotes.Replica = ReplicatedStorage:WaitForChild("RemoteEvents", 5):WaitForChild("ReplicaSignal", 5) end)
	print("SURPG: Remotes Loaded")
end)

-- // 6. UI SETUP //
if PlayerGui:FindFirstChild("SURPG_UI_v2_4") then PlayerGui["SURPG_UI_v2_4"]:Destroy() end
local gui = Instance.new("ScreenGui")
gui.Name = "SURPG_UI_v2_4"
gui.ResetOnSpawn = false
gui.Parent = PlayerGui
gui.IgnoreGuiInset = true

if SCALE_FACTOR ~= 1 then
	local s = Instance.new("UIScale", gui)
	s.Scale = SCALE_FACTOR
end

-- // 7. UTILS //
local function doTween(obj, props, time)
	TweenService:Create(obj, TweenInfo.new(time or 0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

local function GetNextOrder()
	LayoutCounter = LayoutCounter + 1
	return LayoutCounter
end

local function Notify(text, color)
	local b = Instance.new("Frame", gui)
	b.Size = UDim2.new(0, 240, 0, 36)
	b.Position = UDim2.new(0.5, -120, 0.88, 0)
	b.BackgroundColor3 = color or CurrentTheme.banner
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)

	local l = Instance.new("TextLabel", b)
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = 1
	l.Text = text
	l.TextColor3 = CurrentTheme.text
	l.Font = UI_FONT
	l.TextSize = 14

	doTween(b, {Position = UDim2.new(0.5, -120, 0.85, 0)}, 0.3)
	task.delay(2, function()
		doTween(b, {Position = UDim2.new(0.5, -120, 0.9, 0), BackgroundTransparency = 1}, 0.5)
		doTween(l, {TextTransparency = 1}, 0.5)
		task.wait(0.5)
		b:Destroy()
	end)
end

-- // 8. MAIN FRAME & DRAGGING //
local MainFrame = Instance.new("Frame", gui)
MainFrame.Size = CLOSED_SIZE
MainFrame.Position = UDim2.new(0.5, - (CLOSED_SIZE.X.Offset/2), 0.4, 0)
MainFrame.BackgroundColor3 = CurrentTheme.base
MainFrame.ClipsDescendants = true
Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 14)
local MainStroke = Instance.new("UIStroke", MainFrame)
MainStroke.Color = CurrentTheme.stroke
MainStroke.Thickness = 2

local TopBar = Instance.new("Frame", MainFrame)
TopBar.Size = UDim2.new(1, 0, 0, 45)
TopBar.BackgroundTransparency = 1

local Title = Instance.new("TextLabel", TopBar)
Title.Text = "[Update 2.4] SURPG"
Title.Size = UDim2.fromScale(1, 1)
Title.BackgroundTransparency = 1
Title.TextColor3 = CurrentTheme.text
Title.Font = UI_FONT
Title.TextSize = 18

local MinBtn = Instance.new("TextButton", TopBar)
MinBtn.Text = "+"
MinBtn.Size = UDim2.new(0, 45, 1, 0)
MinBtn.Position = UDim2.new(1, -45, 0, 0)
MinBtn.BackgroundTransparency = 1
MinBtn.TextColor3 = CurrentTheme.subtext
MinBtn.Font = UI_FONT
MinBtn.TextSize = 24

-- Draggable Logic
local dragging, dragInput, dragStart, startPos
TopBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = MainFrame.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then dragging = false end
		end)
	end
end)
TopBar.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)
UserInputService.InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		local delta = input.Position - dragStart
		MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)

-- Minimize Logic
local Minimized = true
local function ToggleUI()
	Minimized = not Minimized
	if Minimized then
		doTween(MainFrame, {Size = CLOSED_SIZE})
		MinBtn.Text = "+"
	else
		doTween(MainFrame, {Size = OPEN_SIZE})
		MinBtn.Text = "-"
	end
end
MinBtn.MouseButton1Click:Connect(ToggleUI)

-- // 9. CONTENT SCROLLING //
local Content = Instance.new("ScrollingFrame", MainFrame)
Content.Size = UDim2.new(1, 0, 1, -45)
Content.Position = UDim2.new(0, 0, 0, 45)
Content.BackgroundTransparency = 1
Content.ScrollBarThickness = 3
Content.ScrollBarImageColor3 = CurrentTheme.accent

local UIList = Instance.new("UIListLayout", Content)
UIList.HorizontalAlignment = Enum.HorizontalAlignment.Center
UIList.Padding = UDim.new(0, 6)
UIList.SortOrder = Enum.SortOrder.LayoutOrder -- THIS IS CRITICAL FOR SORTING

local UIPad = Instance.new("UIPadding", Content)
UIPad.PaddingTop = UDim.new(0, 5)
UIPad.PaddingBottom = UDim.new(0, 10)

-- // 10. UI BUILDERS //
local function CreateSection(text)
	local l = Instance.new("TextLabel", Content)
	l.Text = text
	l.Size = UDim2.new(1, -20, 0, 25)
	l.BackgroundTransparency = 1
	l.TextColor3 = CurrentTheme.accent
	l.Font = UI_FONT
	l.TextSize = 12
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.LayoutOrder = GetNextOrder() -- Assign Order
end

local function CreateButton(text, callback)
	local b = Instance.new("TextButton", Content)
	b.Size = UDim2.new(1, -12, 0, 42)
	b.BackgroundColor3 = Color3.fromRGB(45, 50, 65) -- Slightly lighter than base
	b.Text = ""
	b.LayoutOrder = GetNextOrder() -- Assign Order

	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
	local s = Instance.new("UIStroke", b)
	s.Color = CurrentTheme.stroke
	s.Thickness = 1

	local t = Instance.new("TextLabel", b)
	t.Text = text
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.TextColor3 = CurrentTheme.text
	t.Font = UI_FONT
	t.TextSize = 14

	b.MouseButton1Click:Connect(function()
		doTween(b, {Size = UDim2.new(1, -16, 0, 40)}, 0.1)
		task.delay(0.1, function() doTween(b, {Size = UDim2.new(1, -12, 0, 42)}, 0.1) end)

		local success = callback()
		if success then
			doTween(s, {Color = CurrentTheme.success}, 0.3)
			task.delay(0.5, function() doTween(s, {Color = CurrentTheme.stroke}, 0.5) end)
		else
			doTween(s, {Color = CurrentTheme.danger}, 0.3)
			task.delay(0.5, function() doTween(s, {Color = CurrentTheme.stroke}, 0.5) end)
		end
	end)
	return b -- Return button for extra customization (dots)
end

-- // 11. FEATURES LOGIC //

-- [SECTION 1: QUESTS]
CreateSection("QUESTS")

CreateButton("Complete Tails Quest", function()
	if Remotes.Quest then
		local args = { "CompletedToNPC", "Tails", "ScrapSearch", "Tails" }
		Remotes.Quest:FireServer(unpack(args))
		Notify("Tails Quest Done!", CurrentTheme.success)
		return true
	else
		Notify("Quest Remote Not Found", CurrentTheme.danger)
		return false
	end
end)

-- [SECTION 2: FORMS]
CreateSection("FORMS")

local function FireForm(formName)
	if Remotes.Replica then
		local args = { 334, "SetChosenForm", formName }
		Remotes.Replica:FireServer(unpack(args))
		Notify("Form Set: " .. formName, CurrentTheme.success)
		return true
	else
		Notify("ReplicaSignal Missing", CurrentTheme.danger)
		return false
	end
end

CreateButton("Super Form", function() return FireForm("Super") end)
CreateButton("Dark Form", function() return FireForm("Dark") end)
CreateButton("Hyper Form", function() return FireForm("Hyper") end)

-- [SECTION 3: CHAOS EMERALDS]
CreateSection("CHAOS EMERALDS (Teleport)")

local function TeleportEmerald(color)
	if Remotes.Chaos then
		Remotes.Chaos:FireServer(color)
		Notify("Warped to " .. color, CurrentTheme.success)
		return true
	else
		Notify("Chaos Remote Missing", CurrentTheme.danger)
		return false
	end
end

