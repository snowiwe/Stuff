local FpsCont, FpsLabel = CreateMonitorLabel("FPS: --")
local PingCont, PingLabel = CreateMonitorLabel("Ping: --")
local MemCont, MemLabel = CreateMonitorLabel("Mem: --")
local RemoteCont, RemoteLabel = CreateMonitorLabel("Remotes: --")

local function AnimateMonitor(container, label, enabled, content)
	if enabled then
		label.Text = content
		if container.Size.Y.Offset == 0 then
			doTween(container, {Size = UDim2.new(1, 0, 0, 20)}, 0.4, Enum.EasingStyle.Quart)
			doTween(label, {TextTransparency = 0}, 0.3)
		end
	else
		if container.Size.Y.Offset > 0 then
			doTween(container, {Size = UDim2.new(1, 0, 0, 0)}, 0.4, Enum.EasingStyle.Quart)
			doTween(label, {TextTransparency = 1}, 0.2)
		end
	end
end

RunService.RenderStepped:Connect(function(dt)
	local activeCount = (MonitorFPS and 1 or 0) + (MonitorPing and 1 or 0) + (MonitorMem and 1 or 0) + (MonitorRemotes and 1 or 0)

	if activeCount == 0 then
		MonitorUI.Visible = false
		MonitorUI.Size = UDim2.new(0, 100, 0, 0) 
	else
		MonitorUI.Visible = true

		local fpsVal = math.floor(1/dt)
		AnimateMonitor(FpsCont, FpsLabel, MonitorFPS, "FPS: " .. fpsVal)

		local pingVal = math.floor(Players.LocalPlayer:GetNetworkPing() * 1000)
		AnimateMonitor(PingCont, PingLabel, MonitorPing, "Ping: " .. pingVal .. "ms")

		local memVal = math.floor(Stats:GetTotalMemoryUsageMb())
		AnimateMonitor(MemCont, MemLabel, MonitorMem, "Mem: " .. memVal .. "MB")

		local remText = RemotesActive and "Remotes: OK" or "Remotes: N/A"
		AnimateMonitor(RemoteCont, RemoteLabel, MonitorRemotes, remText)
		if RemotesActive then RemoteLabel.TextColor3 = CurrentTheme.success else RemoteLabel.TextColor3 = CurrentTheme.danger end

		local targetH = (activeCount * 20) + 5 
		doTween(MonitorUI, {Size = UDim2.new(0, 100, 0, targetH)}, 0.4, Enum.EasingStyle.Quart)
	end
end)

