-- // DRAGGABLE LOGIC //
local dragging, dragInput, dragStart, startPos

local function clampToScreen(position)
    local viewport = Workspace.CurrentCamera.ViewportSize
    local size = MainFrame.AbsoluteSize
    local x = math.clamp(position.X.Offset, 0, viewport.X - size.X)
    local y = math.clamp(position.Y.Offset, 0, viewport.Y - size.Y)
    return UDim2.new(0, x, 0, y)
end

TopBar.InputBegan:Connect(function(input)
    if not DraggableEnabled then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end)
    end
end)

TopBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        local newPos = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        MainFrame.Position = clampToScreen(newPos)
    end
end)

Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
    MainFrame.Position = clampToScreen(MainFrame.Position)
end)

