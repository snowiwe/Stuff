-- // TOGGLE UI //
local function ToggleUI()
	if MainFrame.Visible then
		if AnimationsEnabled then
			TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In), {Size = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 1}):Play()
			task.wait(0.3)
			MainFrame.Visible = false
		else
			MainFrame.Visible = false
		end
	else
		MainFrame.Visible = true
		local TargetSize = Minimized and CLOSED_SIZE or OPEN_SIZE
		ContentArea.Visible = not Minimized 
		MinBtn.Rotation = Minimized and 0 or 180

		if AnimationsEnabled then
			MainFrame.Size = UDim2.new(0, 0, 0, 0)
			MainFrame.BackgroundTransparency = 1
			TweenService:Create(MainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = TargetSize, BackgroundTransparency = 0}):Play()
		else
			MainFrame.Size = TargetSize
			MainFrame.BackgroundTransparency = 0
		end
	end
end

