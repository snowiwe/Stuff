local function Notify(text, color)
    if not NotificationsEnabled then return end

    local banner = Instance.new("Frame")
    banner.Size = UDim2.new(0, 220, 0, 34)
    banner.Position = UDim2.new(0.5, -110, 0.9, 0) 
    banner.BackgroundColor3 = color or CurrentTheme.banner
    banner.BackgroundTransparency = 1
    banner.BorderSizePixel = 0
    banner.Parent = NotifContainer
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = banner
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1,1)
    label.BackgroundTransparency = 1
    label.TextColor3 = CurrentTheme.text
    label.Font = UI_FONT
    label.TextSize = 14
    label.Text = text
    label.TextTransparency = 1
    label.Parent = banner
    
    doTween(banner, {BackgroundTransparency = 0, Position = UDim2.new(0.5, -110, 0.85, 0)}, 0.3)
    doTween(label, {TextTransparency = 0}, 0.3)
    
    task.delay(2, function()
        doTween(banner, {BackgroundTransparency = 1, Position = UDim2.new(0.5, -110, 0.9, 0)}, 0.5)
        doTween(label, {TextTransparency = 1}, 0.5)
        task.wait(0.5)
        banner:Destroy()
    end)
end

