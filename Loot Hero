    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 42)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.Parent = frame

    local tLbl = Instance.new("TextLabel")
    tLbl.Text = title
    tLbl.Font = Enum.Font.GothamMedium
    tLbl.TextSize = 12
    tLbl.TextColor3 = C.Text
    tLbl.Position = UDim2.new(0, 10, 0, 0)
    tLbl.Size = UDim2.new(1, -40, 0, 42)
    tLbl.TextXAlignment = Enum.TextXAlignment.Left
    tLbl.BackgroundTransparency = 1
    tLbl.Parent = btn

    local arrow = Instance.new("TextLabel")
    arrow.Text = "▼"
    arrow.Font = Enum.Font.GothamBold
    arrow.TextSize = 10
    arrow.TextColor3 = C.Dim
    arrow.Position = UDim2.new(1, -24, 0, 0)
    arrow.Size = UDim2.new(0, 14, 0, 42)
    arrow.BackgroundTransparency = 1
    arrow.Parent = btn

    local optContainer = Instance.new("Frame")
    optContainer.Size = UDim2.new(1, -12, 0, 0)
    optContainer.Position = UDim2.new(0, 6, 0, 44)
    optContainer.BackgroundTransparency = 1
    optContainer.Parent = frame

    local optList = Instance.new("UIListLayout")
    optList.Padding = UDim.new(0, 4)
    optList.Parent = optContainer

    local isOpen = false
    local function setOpen(open)
        isOpen = open
        tw(arrow, {Rotation = isOpen and 180 or 0}, 0.2)
        local totalH = isOpen and (48 + (#options * 28)) or 42
        tw(frame, {Size = UDim2.new(1, 0, 0, totalH)}, 0.22, Enum.EasingStyle.Quart)
    end

    btn.MouseButton1Click:Connect(function() setOpen(not isOpen) end)

    for _, opt in ipairs(options) do
        local optBtn = Instance.new("TextButton")
        optBtn.Size = UDim2.new(1, 0, 0, 24)
        optBtn.BackgroundColor3 = C.Hover
        optBtn.Text = opt
        optBtn.TextColor3 = C.Muted
        optBtn.Font = Enum.Font.Gotham
        optBtn.TextSize = 11
        optBtn.AutoButtonColor = false
        Instance.new("UICorner", optBtn).CornerRadius = UDim.new(0, 5)
        optBtn.Parent = optContainer

        optBtn.MouseButton1Click:Connect(function()
            tLbl.Text = title .. ": " .. opt
            setOpen(false)
            callback(opt)
        end)
    end
end

