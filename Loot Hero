    end)
    card.MouseLeave:Connect(function()
        tw(card, {BackgroundColor3 = C.Surface}, 0.15)
        tw(s, {Color = C.Border}, 0.15)
    end)

    card.MouseButton1Click:Connect(function()
        state = not state
        tw(track, {BackgroundColor3 = state and C.Accent or C.Border}, 0.2)
