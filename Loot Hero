-- // 7. THEME MANAGER //
local ThemeableObjects = {
    Frames = {}, Texts = {}, Strokes = {}, Gradients = {}, Images = {}
}

local ThemeLabelRef = nil 
local StartGameBtnRef = nil 

local function RegisterThemeObj(obj, prop, key)
    if not obj then return end
    if obj:IsA("Frame") or obj:IsA("ScrollingFrame") or obj:IsA("TextButton") then
        table.insert(ThemeableObjects.Frames, {obj, prop, key})
    elseif obj:IsA("TextLabel") then
        table.insert(ThemeableObjects.Texts, {obj, prop, key})
    elseif obj:IsA("UIStroke") then
        table.insert(ThemeableObjects.Strokes, {obj, prop, key})
    elseif obj:IsA("UIGradient") then
        table.insert(ThemeableObjects.Gradients, {obj, prop, key})
    elseif obj:IsA("ImageButton") or obj:IsA("ImageLabel") then
        table.insert(ThemeableObjects.Images, {obj, prop, key})
    end
end

local function UpdateTheme(themeName)
    if not THEMES[themeName] then return end
    CurrentTheme = THEMES[themeName]
    
    for _, item in ipairs(ThemeableObjects.Frames) do item[1][item[2]] = CurrentTheme[item[3]] end
    for _, item in ipairs(ThemeableObjects.Texts) do item[1][item[2]] = CurrentTheme[item[3]] end
    for _, item in ipairs(ThemeableObjects.Strokes) do item[1][item[2]] = CurrentTheme[item[3]] end
    for _, item in ipairs(ThemeableObjects.Gradients) do item[1][item[2]] = CurrentTheme[item[3]] end
    for _, item in ipairs(ThemeableObjects.Images) do item[1][item[2]] = CurrentTheme[item[3]] end
    
    if ThemeLabelRef then ThemeLabelRef.Text = "Theme: " .. CurrentTheme.name end
    
    if ActiveCheats.StartGame and StartGameBtnRef then
        local s = StartGameBtnRef:FindFirstChild("UIStroke")
        local t = StartGameBtnRef:FindFirstChild("TextLabel")
        if s then s.Color = CurrentTheme.success end
        if t then t.TextColor3 = CurrentTheme.success end
    end
end

-- // 8. ANIMATION & INTRO //
local function doTween(obj, props, time)
    if not AnimationsEnabled then
        for k,v in pairs(props) do obj[k] = v end
        return
    end
    TweenService:Create(obj, TweenInfo.new(time or 0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

local function PlayIntro()
    if not AnimationsEnabled then return end
    local IntroFrame = Instance.new("Frame")
    IntroFrame.Size = UDim2.fromScale(1,1)
    IntroFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
    IntroFrame.ZIndex = 500
    IntroFrame.Parent = gui
    
    local BarBG = Instance.new("Frame")
    BarBG.Size = UDim2.new(0, 200, 0, 6)
    BarBG.Position = UDim2.fromScale(0.5, 0.55)
    BarBG.AnchorPoint = Vector2.new(0.5, 0.5)
    BarBG.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    BarBG.Parent = IntroFrame
    Instance.new("UICorner", BarBG).CornerRadius = UDim.new(1,0)
    
    local BarFill = Instance.new("Frame")
    BarFill.Size = UDim2.new(0, 0, 1, 0)
    BarFill.BackgroundColor3 = CurrentTheme.accent
    BarFill.Parent = BarBG
    Instance.new("UICorner", BarFill).CornerRadius = UDim.new(1,0)
    
    local Logo = Instance.new("TextLabel")
    Logo.Text = "Loot Hero"
    Logo.Font = Enum.Font.GothamBlack
    Logo.TextSize = 32
    Logo.TextColor3 = CurrentTheme.text
    Logo.Position = UDim2.fromScale(0.5, 0.45)
    Logo.AnchorPoint = Vector2.new(0.5, 0.5)
    Logo.BackgroundTransparency = 1
    Logo.TextTransparency = 1
    Logo.Parent = IntroFrame
    
    TweenService:Create(Logo, TweenInfo.new(1), {TextTransparency = 0}):Play()
    TweenService:Create(BarFill, TweenInfo.new(1.5, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = UDim2.new(1,0,1,0)}):Play()
    
    task.wait(1.8)
    TweenService:Create(IntroFrame, TweenInfo.new(0.5), {BackgroundTransparency = 1}):Play()
    TweenService:Create(Logo, TweenInfo.new(0.5), {TextTransparency = 1}):Play()
    TweenService:Create(BarBG, TweenInfo.new(0.5), {BackgroundTransparency = 1}):Play()
    TweenService:Create(BarFill, TweenInfo.new(0.5), {BackgroundTransparency = 1}):Play()
    
    task.wait(0.5)
    IntroFrame:Destroy()
end

