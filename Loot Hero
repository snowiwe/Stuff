-- // INTRO FUNCTION //
local function PlayIntro()
	if not AnimationsEnabled then return end
	local IntroFrame = Instance.new("Frame")
	IntroFrame.Size = UDim2.fromScale(1,1)
	IntroFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
	IntroFrame.ZIndex = 500
	IntroFrame.Parent = gui

	local BarBG = Instance.new("Frame")
	BarBG.Size = UDim2.new(0, 200, 0, 6)
	BarBG.Position = UDim2.fromScale(0.5, 0.55)
	BarBG.AnchorPoint = Vector2.new(0.5, 0.5)
	BarBG.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
	BarBG.Parent = IntroFrame
	Instance.new("UICorner", BarBG).CornerRadius = UDim.new(1,0)

	local BarFill = Instance.new("Frame")
	BarFill.Size = UDim2.new(0, 0, 1, 0)
	BarFill.BackgroundColor3 = Theme.accent
	BarFill.Parent = BarBG
	Instance.new("UICorner", BarFill).CornerRadius = UDim.new(1,0)

	local Logo = Instance.new("TextLabel")
	Logo.Text = "Loot Hero"
	Logo.Font = Enum.Font.GothamBlack
	Logo.TextSize = 32
	Logo.TextColor3 = Theme.text
	Logo.Position = UDim2.fromScale(0.5, 0.45)
	Logo.AnchorPoint = Vector2.new(0.5, 0.5)
	Logo.BackgroundTransparency = 1
	Logo.TextTransparency = 1
	Logo.Parent = IntroFrame

	TweenService:Create(Logo, TweenInfo.new(1), {TextTransparency = 0}):Play()
	TweenService:Create(BarFill, TweenInfo.new(1.5, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = UDim2.new(1,0,1,0)}):Play()

	task.wait(1.8)
	TweenService:Create(IntroFrame, TweenInfo.new(0.5), {BackgroundTransparency = 1}):Play()
	TweenService:Create(Logo, TweenInfo.new(0.5), {TextTransparency = 1}):Play()
	TweenService:Create(BarBG, TweenInfo.new(0.5), {BackgroundTransparency = 1}):Play()
	TweenService:Create(BarFill, TweenInfo.new(0.5), {BackgroundTransparency = 1}):Play()

	task.wait(0.5)
	IntroFrame:Destroy()
end

PlayIntro()
print("Loot Hero [Alpha] - v3.2 (Mobile Optimized)")
