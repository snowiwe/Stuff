local NotifyQueue = {}
local isDisplayingNotify = false

local function processNextNotification()
    if #NotifyQueue == 0 or isDisplayingNotify or not NotificationsEnabled then return end
    isDisplayingNotify = true
    local item = table.remove(NotifyQueue, 1)

    nbTitle.Text = item.title
    nbSub.Text = item.sub or "System update"
    nbStroke.Color = item.color or C.Accent
    nbBar.BackgroundColor3 = item.color or C.Accent

    NotificationBanner.Visible = true
    NotificationBanner.Position = UDim2.new(0.5, 0, 0, -42)
    NotificationBanner.BackgroundTransparency = 1
    nbTitle.TextTransparency = 1
    nbSub.TextTransparency = 1
    nbStroke.Transparency = 1
    nbBar.BackgroundTransparency = 1

    tw(NotificationBanner, {Position = UDim2.new(0.5, 0, 0, 7), BackgroundTransparency = 0}, 0.22, Enum.EasingStyle.Back)
    tw(nbTitle, {TextTransparency = 0}, 0.2)
    tw(nbSub, {TextTransparency = 0}, 0.2)
    tw(nbStroke, {Transparency = 0}, 0.2)
    tw(nbBar, {BackgroundTransparency = 0}, 0.2)

    task.wait(2.2)

    local exit = tw(NotificationBanner, {Position = UDim2.new(0.5, 0, 0, -42), BackgroundTransparency = 1}, 0.22, Enum.EasingStyle.Quart)
    tw(nbTitle, {TextTransparency = 1}, 0.2)
    tw(nbSub, {TextTransparency = 1}, 0.2)
    tw(nbStroke, {Transparency = 1}, 0.2)
    tw(nbBar, {BackgroundTransparency = 1}, 0.2)
    exit.Completed:Wait()

    NotificationBanner.Visible = false
    isDisplayingNotify = false

    if #NotifyQueue > 0 then
        processNextNotification()
    end
end

local function Notify(titleText, subText, color)
    if not NotificationsEnabled then return end
    table.insert(NotifyQueue, {title = titleText, sub = subText, color = color})
    if not isDisplayingNotify then
        task.spawn(processNextNotification)
    end
end

