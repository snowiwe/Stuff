	pLayout.Padding = UDim.new(0, 8)
	pLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	pLayout.SortOrder = Enum.SortOrder.LayoutOrder
	pLayout.Parent = Page

	local pPad = Instance.new("UIPadding")
	pPad.PaddingTop = UDim.new(0,5)
	pPad.PaddingBottom = UDim.new(0,5)
	pPad.Parent = Page

	Pages[name] = {Btn = TabBtn, Page = Page}

	TabBtn.MouseButton1Click:Connect(function()
		for n, data in pairs(Pages) do
			if n == name then
				data.Page.Visible = true
				data.Page.CanvasPosition = Vector2.new(0, 10)
				TweenService:Create(data.Page, TweenInfo.new(0.3), {CanvasPosition = Vector2.new(0,0)}):Play()
