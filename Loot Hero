CreateToggle(SettingsTab, "No Camera Shake", "Disables Bobbing/Recoil", false, function(value)
    NoShakeEnabled = value
    if NoShakeEnabled then
        Notify("Camera Locked (Steady)", Theme.success)
        if ShakeConnection then ShakeConnection:Disconnect() end
        ShakeConnection = RunService.RenderStepped:Connect(function()
            if player.Character and player.Character:FindFirstChild("Humanoid") then
                player.Character.Humanoid.CameraOffset = Vector3.new(0, 0, 0)
            end
        end)
    else
        Notify("Camera Shake Enabled", Theme.danger)
        if ShakeConnection then ShakeConnection:Disconnect() end
    end
end)

CreateToggle(SettingsTab, "ESP", "Highlight Players/Enemies", false, function(value)
    EspEnabled = value
    if EspEnabled then
        Notify("ESP Enabled", Theme.success)
        for _, v in ipairs(Workspace:GetDescendants()) do
            if v:IsA("Model") and v:FindFirstChild("Humanoid") and v ~= player.Character then
                local hl = Instance.new("Highlight")
                hl.Name = "LootESP"
                hl.FillTransparency = 0.5
                hl.OutlineTransparency = 0
                hl.FillColor = Color3.fromRGB(255, 0, 0)
                hl.Parent = v
                table.insert(EspHighlights, hl)
            end
        end
    else
        Notify("ESP Disabled", Theme.danger)
        for _, hl in ipairs(EspHighlights) do
            if hl then hl:Destroy() end
        end
        EspHighlights = {}
    end
end)

