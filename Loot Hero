-- // 11. CLAMPING & DRAGGING //
local function clampPosition(posUDim, obj)
    local view = (Camera and Camera.ViewportSize) or Vector2.new(800, 600)
    if view.X <= 20 or view.Y <= 20 then return posUDim end

    local absX = (posUDim.X.Scale * view.X) + posUDim.X.Offset
    local absY = (posUDim.Y.Scale * view.Y) + posUDim.Y.Offset

    local w = obj.AbsoluteSize.X > 0 and obj.AbsoluteSize.X or 275
    local h = obj.AbsoluteSize.Y > 0 and obj.AbsoluteSize.Y or 315

    local halfW = w / 2
    local halfH = h / 2
    local pad = 6

    local minX = halfW + pad
    local maxX = math.max(minX, view.X - halfW - pad)
    local minY = halfH + pad
    local maxY = math.max(minY, view.Y - halfH - pad)

    return UDim2.new(0, math.clamp(absX, minX, maxX), 0, math.clamp(absY, minY, maxY))
end

local dragging = false
local dragStart = nil
local startPos = nil

Header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = Frame.Position

        local moveConn
        local endConn

        moveConn = UserInputService.InputChanged:Connect(function(moveInput)
            if (moveInput.UserInputType == Enum.UserInputType.MouseMovement or moveInput.UserInputType == Enum.UserInputType.Touch) and dragging then
                local delta = moveInput.Position - dragStart
                local rawPos = UDim2.new(
                    startPos.X.Scale,
                    startPos.X.Offset + delta.X,
                    startPos.Y.Scale,
                    startPos.Y.Offset + delta.Y
                )
                Frame.Position = clampPosition(rawPos, Frame)
            end
        end)

        endConn = UserInputService.InputEnded:Connect(function(endInput)
            if endInput.UserInputType == Enum.UserInputType.MouseButton1 or endInput.UserInputType == Enum.UserInputType.Touch then
                dragging = false
                if moveConn then moveConn:Disconnect() end
                if endConn then endConn:Disconnect() end
            end
        end)
    end
end)

