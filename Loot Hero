local fpsRow = createMonitorRow()
local pingRow = createMonitorRow()
local memRow = createMonitorRow()
local remoteRow = createMonitorRow()

local monitorConn
monitorConn = RunService.RenderStepped:Connect(function(dt)
    local active = (MonitorFPS and 1 or 0) + (MonitorPing and 1 or 0) + (MonitorMem and 1 or 0) + (MonitorRemotes and 1 or 0)
    if active == 0 then
        MonitorUI.Visible = false
    else
        MonitorUI.Visible = true
        MonitorUI.Size = UDim2.new(0, 95, 0, (active * 18) + 6)

        fpsRow.Visible = MonitorFPS
        if MonitorFPS then fpsRow.Text = "FPS: " .. math.floor(1 / dt) end

        pingRow.Visible = MonitorPing
        if MonitorPing then
            local p = math.floor(LocalPlayer:GetNetworkPing() * 1000)
            pingRow.Text = "Ping: " .. p .. "ms"
        end

        memRow.Visible = MonitorMem
        if MonitorMem then
            memRow.Text = "Mem: " .. math.floor(Stats:GetTotalMemoryUsageMb()) .. "MB"
        end

        remoteRow.Visible = MonitorRemotes
        if MonitorRemotes then
            remoteRow.Text = RemotesActive and "Remotes: OK" or "Remotes: N/A"
            remoteRow.TextColor3 = RemotesActive and C.Green or C.Red
        end
    end
end)

