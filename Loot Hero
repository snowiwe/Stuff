        if AnimationsEnabled then
            local t = tw(MobileToggle, {Size = UDim2.new(0, 0, 0, 0), Rotation = -90}, 0.2, Enum.EasingStyle.Quart)
            t.Completed:Connect(function()
                if not MobileToggle.Visible or MobileToggle.Size.X.Offset == 0 then
                    MobileToggle.Visible = false
                end
            end)
        else
            MobileToggle.Visible = false
        end
    end
end

toggleMenu = function()
    if isOpen then closeMenu() else openMenu() end
end

local iconDragging = false
local iconDragStart = nil
local iconStartPos = nil

MobileToggle.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        iconDragging = false
        iconDragStart = input.Position
        iconStartPos = MobileToggle.Position

        local moveConn, endConn
        moveConn = UserInputService.InputChanged:Connect(function(moveInput)
            if (moveInput.UserInputType == Enum.UserInputType.MouseMovement or moveInput.UserInputType == Enum.UserInputType.Touch) and iconDragStart then
                local delta = moveInput.Position - iconDragStart
                if delta.Magnitude > 6 then
                    iconDragging = true
                    local raw = UDim2.new(iconStartPos.X.Scale, iconStartPos.X.Offset + delta.X, iconStartPos.Y.Scale, iconStartPos.Y.Offset + delta.Y)
                    MobileToggle.Position = clampPosition(raw, MobileToggle)
                end
            end
        end)

        endConn = UserInputService.InputEnded:Connect(function(endInput)
            if endInput.UserInputType == Enum.UserInputType.MouseButton1 or endInput.UserInputType == Enum.UserInputType.Touch then
                if moveConn then moveConn:Disconnect() end
                if endConn then endConn:Disconnect() end
                if not iconDragging then toggleMenu() end
                iconDragging = false
                iconDragStart = nil
            end
        end)
    end
end)

UserInputService.InputBegan:Connect(function(inp, gpe)
    if not gpe and inp.KeyCode == Enum.KeyCode.RightControl then
        toggleMenu()
    end
end)

openMenu()
Notify("Lumacore", "Poly Loot Initialized", C.Accent)
print("[Lumacore] Poly Loot loaded.")
