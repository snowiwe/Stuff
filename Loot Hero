local Remotes, HealRemote, ChoiceRemote, MoneyRemote, StartRemote, PurchaseRemote, UpdateRemote
task.spawn(function()
    pcall(function()
        Remotes = ReplicatedStorage:WaitForChild("Remotes", 5)
        if Remotes then
            HealRemote = Remotes:WaitForChild("Heal", 3)
            ChoiceRemote = Remotes:WaitForChild("Choice", 3)
            MoneyRemote = Remotes:WaitForChild("Money", 3)
            StartRemote = Remotes:WaitForChild("Start", 3)
            PurchaseRemote = Remotes:WaitForChild("Purchase", 3)
            UpdateRemote = Remotes:WaitForChild("Update", 3)
        end
