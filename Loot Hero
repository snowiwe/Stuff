-- // 7. THEME MANAGER //
local ThemeableObjects = {
    Frames = {}, Texts = {}, Strokes = {}, Gradients = {}, Images = {}
}

local ThemeLabelRef = nil 

local function RegisterThemeObj(obj, prop, key)
    if not obj then return end
    if obj:IsA("Frame") or obj:IsA("ScrollingFrame") or obj:IsA("TextButton") then
        table.insert(ThemeableObjects.Frames, {obj, prop, key})
    elseif obj:IsA("TextLabel") then
        table.insert(ThemeableObjects.Texts, {obj, prop, key})
    elseif obj:IsA("UIStroke") then
        table.insert(ThemeableObjects.Strokes, {obj, prop, key})
    elseif obj:IsA("UIGradient") then
        table.insert(ThemeableObjects.Gradients, {obj, prop, key})
    elseif obj:IsA("ImageButton") or obj:IsA("ImageLabel") then
        table.insert(ThemeableObjects.Images, {obj, prop, key})
    end
end

local function UpdateTheme(themeName)
    if not THEMES[themeName] then return end
    CurrentTheme = THEMES[themeName]
    
    for _, item in ipairs(ThemeableObjects.Frames) do item[1][item[2]] = CurrentTheme[item[3]] end
    for _, item in ipairs(ThemeableObjects.Texts) do item[1][item[2]] = CurrentTheme[item[3]] end
    for _, item in ipairs(ThemeableObjects.Strokes) do item[1][item[2]] = CurrentTheme[item[3]] end
    for _, item in ipairs(ThemeableObjects.Gradients) do item[1][item[2]] = CurrentTheme[item[3]] end
    for _, item in ipairs(ThemeableObjects.Images) do item[1][item[2]] = CurrentTheme[item[3]] end
    
    if ThemeLabelRef then
        ThemeLabelRef.Text = "Theme: " .. CurrentTheme.name
    end
end

-- // 8. ANIMATION HELPERS //
local function doTween(obj, props, time)
    if not AnimationsEnabled then
        for k,v in pairs(props) do obj[k] = v end
        return
    end
    TweenService:Create(obj, TweenInfo.new(time or 0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

