    TabBtn.MouseButton1Click:Connect(function()
        for n, data in pairs(Pages) do
            if n == name then
                data.Page.Visible = true
                data.Page.CanvasPosition = Vector2.new(0, 10)
                TweenService:Create(data.Page, TweenInfo.new(0.3), {CanvasPosition = Vector2.new(0,0)}):Play()
                doTween(data.Btn, {TextColor3 = CurrentTheme.text, BackgroundColor3 = CurrentTheme.banner})
            else
                data.Page.Visible = false
                doTween(data.Btn, {TextColor3 = CurrentTheme.subtext, BackgroundColor3 = CurrentTheme.base})
            end
        end
    end)
    
    return Page
