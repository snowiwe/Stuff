		task.delay(0.5, function() doTween(s, {Color = CurrentTheme.stroke}); doTween(TitleL, {TextColor3 = CurrentTheme.text}) end)
	end

	Btn.MouseButton1Click:Connect(function()
		doTween(Btn, {Size = UDim2.new(1, -18, 0, 48)}, 0.1)
		task.delay(0.1, function() doTween(Btn, {Size = UDim2.new(1, -12, 0, 50)}, 0.1) end)
		callback(success, fail, TitleL)
	end)
