CreateToggle(MainTab, "Auto Spin", "Automatically spins the wheel", function(val)
	AutoSpinEnabled = val
	if val then
		task.spawn(function()
			while AutoSpinEnabled do
				if WheelSpin then
					local args = { false }
					WheelSpin:InvokeServer(unpack(args))
				end
				task.wait(4)
			end
		end)
	end
end)

-- Auto Claim
CreateToggle(MainTab, "Auto Claim Gifts", "Loops slots 1 to 12", function(val)
	AutoClaimEnabled = val
	if val then
		task.spawn(function()
			while AutoClaimEnabled do
				for i = 1, 12 do
					if not AutoClaimEnabled then break end
					if GiftClaim then
						pcall(function()
							local args = { i }
							GiftClaim:InvokeServer(unpack(args))
						end)
					end
					task.wait(0.1)
				end
				task.wait(1)
			end
		end)
	end
end)

