-- 4. PARRY CONFIG & CORE STATE
local PARRY_SETTINGS = {
    AutoParry       = false,
    ParryCurve      = "High Velocity", -- "High Velocity" or "Default"
    DistanceBuffer  = 12,
    SpamParry       = false,
    SpamThreshold   = 22,
    Visualizer      = false,
}

local lastParryTick = 0
local parryRemotes = {}

local function resolveParryRemote()
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if remotes then
        local names = {"ParryAttempt", "ParryButtonPress", "Parry", "ParrySuccess"}
        for _, name in ipairs(names) do
            local rem = remotes:FindFirstChild(name)
            if rem and (rem:IsA("RemoteEvent") or rem:IsA("RemoteFunction")) then
                table.insert(parryRemotes, rem)
            end
        end
    end
    for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") and string.find(string.lower(obj.Name), "parry") then
            if not table.find(parryRemotes, obj) then
                table.insert(parryRemotes, obj)
            end
        end
    end
end
task.spawn(resolveParryRemote)

local function triggerParry()
    if tick() - lastParryTick < 0.08 and not PARRY_SETTINGS.SpamParry then return end
    lastParryTick = tick()

    pcall(function()
        local VirtualInputManager = game:GetService("VirtualInputManager")
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
        task.wait(0.01)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)
    end)

    for _, remote in ipairs(parryRemotes) do
        pcall(function()
            if remote:IsA("RemoteEvent") then
                remote:FireServer(0.5, CFrame.new(), {}, {})
            elseif remote:IsA("RemoteFunction") then
                remote:InvokeServer(0.5, CFrame.new(), {}, {})
            end
        end)
    end
end

-- Ball Detection & Distance Solver
local function locateTargetBall()
    local ballsFolder = Workspace:FindFirstChild("Balls")
    if ballsFolder then
        for _, child in ipairs(ballsFolder:GetChildren()) do
            if child:IsA("BasePart") and child:GetAttribute("realBall") ~= false then
                return child
            end
            local part = child:FindFirstChildWhichIsA("BasePart")
            if part then return part end
        end
    end
    for _, child in ipairs(Workspace:GetChildren()) do
        if child:IsA("BasePart") and string.find(string.lower(child.Name), "ball") then
            return child
        end
    end
    return nil
end

local VisualizerPart = nil
local function updateVisualizer(pos, radius, active)
    if not PARRY_SETTINGS.Visualizer or not active then
        if VisualizerPart then VisualizerPart.Transparency = 1 end
        return
    end
    if not VisualizerPart then
        VisualizerPart = Instance.new("Part")
        VisualizerPart.Name = "Lumacore_ParryVisualizer"
        VisualizerPart.Shape = Enum.PartType.Ball
        VisualizerPart.Material = Enum.Material.ForceField
        VisualizerPart.Color = C.Cyan
        VisualizerPart.CanCollide = false
        VisualizerPart.CanTouch = false
        VisualizerPart.CanQuery = false
        VisualizerPart.Anchored = true
        VisualizerPart.Parent = Workspace
    end
    VisualizerPart.Size = Vector3.new(radius * 2, radius * 2, radius * 2)
    VisualizerPart.CFrame = CFrame.new(pos)
    VisualizerPart.Transparency = 0.75
end

-- Core Parry Step Runner
RunService.PostSimulation:Connect(function()
    if not PARRY_SETTINGS.AutoParry then
        if VisualizerPart then VisualizerPart.Transparency = 1 end
        return
    end

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local ball = locateTargetBall()
    if not ball then
        if VisualizerPart then VisualizerPart.Transparency = 1 end
        return
    end

    local ballPos = ball.Position
    local charPos = hrp.Position
    local distance = (ballPos - charPos).Magnitude
    local ballVelocity = ball.AssemblyLinearVelocity
    local ballSpeed = ballVelocity.Magnitude

    local targetAttr = ball:GetAttribute("target") or ball:GetAttribute("Target")
    local isTargeted = false
    if targetAttr then
        isTargeted = (tostring(targetAttr) == LocalPlayer.Name or targetAttr == LocalPlayer)
    else
        isTargeted = true
    end

    local ping = LocalPlayer:GetNetworkPing()
    local pingOffset = ping * ballSpeed
    local threshold = PARRY_SETTINGS.DistanceBuffer + (ballSpeed * 0.45) + pingOffset

    if PARRY_SETTINGS.ParryCurve == "High Velocity" then
        threshold = PARRY_SETTINGS.DistanceBuffer + (ballSpeed * 0.55) + (pingOffset * 1.2)
    end

    updateVisualizer(charPos, threshold, true)

    if isTargeted then
        local dot = 1
        if ballSpeed > 2 then
            local toChar = (charPos - ballPos).Unit
            dot = ballVelocity.Unit:Dot(toChar)
        end

        if dot > -0.15 then
            if distance <= threshold then
                triggerParry()
            end
            if PARRY_SETTINGS.SpamParry and distance <= PARRY_SETTINGS.SpamThreshold then
                triggerParry()
            end
        end
    end
end)

