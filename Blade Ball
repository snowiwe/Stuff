-- Performance Potato Mode
local deepPerformanceActive = false
local originalLighting = {}
local modifiedParts = {}
local culledEffects = {}

local function setPartLowDetail(part)
    if not part:IsA("BasePart") and not part:IsA("MeshPart") then return end
    if not modifiedParts[part] then
        modifiedParts[part] = {
            Material = part.Material,
            CastShadow = part.CastShadow,
            Reflectance = part.Reflectance
        }
    end
    part.Material = Enum.Material.SmoothPlastic
    part.CastShadow = false
    part.Reflectance = 0
end

local function applyAggressiveOptimization(enable)
    local Terrain = Workspace:FindFirstChildOfClass("Terrain")
    if enable then
        originalLighting.GlobalShadows = Lighting.GlobalShadows
        originalLighting.FogEnd = Lighting.FogEnd
        originalLighting.Brightness = Lighting.Brightness

        Lighting.GlobalShadows = false
        Lighting.FogEnd = 9e9
        Lighting.Brightness = 1

        for _, item in ipairs(Lighting:GetChildren()) do
            if item:IsA("PostEffect") or item:IsA("Atmosphere") or item:IsA("Clouds") or item:IsA("Sky") then
                if not culledEffects[item] then culledEffects[item] = item.Enabled end
                item.Enabled = false
            end
        end

        if Terrain then
            pcall(function()
                Terrain.Decoration = false
                Terrain.WaterWaveSize = 0
                Terrain.WaterWaveSpeed = 0
                Terrain.WaterReflectance = 0
            end)
        end

        for _, desc in ipairs(Workspace:GetDescendants()) do
            if desc:IsA("ParticleEmitter") or desc:IsA("Trail") or desc:IsA("Smoke") or desc:IsA("Fire") or desc:IsA("Sparkles") then
                if desc.Enabled then
                    culledEffects[desc] = true
                    desc.Enabled = false
                end
            elseif desc:IsA("Decal") or desc:IsA("Texture") then
                if desc.Transparency < 1 then
                    culledEffects[desc] = desc.Transparency
                    desc.Transparency = 1
                end
            elseif desc:IsA("BasePart") then
                setPartLowDetail(desc)
            end
        end
    else
        Lighting.GlobalShadows = originalLighting.GlobalShadows ~= nil and originalLighting.GlobalShadows or true
        Lighting.FogEnd = originalLighting.FogEnd or 100000
        Lighting.Brightness = originalLighting.Brightness or 2

        for item, state in pairs(culledEffects) do
            if item and item.Parent then
                if item:IsA("Decal") or item:IsA("Texture") then
                    item.Transparency = state
                else
                    pcall(function() item.Enabled = state end)
                end
            end
        end
        table.clear(culledEffects)

        if Terrain then
            pcall(function()
                Terrain.Decoration = true
                Terrain.WaterWaveSize = 0.15
                Terrain.WaterWaveSpeed = 10
            end)
        end

        for part, data in pairs(modifiedParts) do
            if part and part.Parent then
                pcall(function()
                    part.Material = data.Material
                    part.CastShadow = data.CastShadow
                    part.Reflectance = data.Reflectance
                end)
            end
        end
        table.clear(modifiedParts)
    end
end

