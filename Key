local function LargeButton(text, onClick)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1,-20,0,45)
	b.Text = text
	b.Font = Enum.Font.SourceSansSemibold
	b.TextSize = 18
	b.BackgroundColor3 = THEME.item 
	b.TextColor3 = Color3.fromRGB(240,240,255)
	b.AutoButtonColor = false
	b.ZIndex = 17
	b.Parent = scroll
	rounded(b,8)

	local s = Instance.new("UIStroke", b); s.Thickness = 1; s.Transparency = 0.6; s.Color = THEME.stroke

	b.MouseEnter:Connect(function() doTween(b, TI_MED, {BackgroundColor3 = Color3.fromRGB(60,75,150)}) end)
	b.MouseLeave:Connect(function() doTween(b, TI_MED, {BackgroundColor3 = THEME.item}) end)
	b.MouseButton1Click:Connect(function()
		doTween(b, TI_FAST, {Size = UDim2.new(1,-24,0,43)})
		task.delay(0.08, function() doTween(b, TI_FAST, {Size = UDim2.new(1,-20,0,45)}) end)
		if onClick then onClick(b) end
	end)

	return b
end

