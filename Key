-- // 4. ACCESS CHECKER //
local function CheckAccess()
	local userId = player.UserId

	-- STEP 1: CHECK BETA LIST (Priority)
	if betaAccess then
		for _, id in pairs(BETA_IDS) do
			if userId == id then
				print("[LumaCore Hub] Beta Access Granted.")
				return true -- Bypass Global Lock
			end
		end
	end

	-- STEP 2: CHECK GLOBAL LOCK
	if not hasAccess then
		warn("[LumaCore Hub] Script is currently closed.")
		return false
	end

	return true -- Public Access
end

