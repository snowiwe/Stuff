local input = LargeInput("Paste Key Here...")
local verifyBtn = LargeButton("Verify Key", function(btn)
	local key = input.Text
	if key == SCRIPT_KEY then
		if not SCRIPT_STATUS then
			btn.Text = "Maintenance Mode"
			btn.BackgroundColor3 = THEME.warning
			return
		end

		if IsGameSupported then
			btn.Text = "Success!"
			btn.BackgroundColor3 = THEME.success

			task.wait(1)
			doTween(dim, TI_MED, {BackgroundTransparency = 1})
			doTween(main, TI_SLOW, {Size = UDim2.new(0,0,0,0)})
			task.wait(0.5)
			gui:Destroy()
			CurrentGameData.Load()
		else
			-- COUNTDOWN DESTRUCTION
			btn.BackgroundColor3 = THEME.danger
			for i = 3, 1, -1 do
				btn.Text = "Unsupported Game ("..i..")"
				task.wait(1)
			end
			btn.Text = "Closing..."
			task.wait(0.5)
			doTween(dim, TI_MED, {BackgroundTransparency = 1})
			doTween(main, TI_SLOW, {Size = UDim2.new(0,0,0,0)})
			task.wait(0.5)
			gui:Destroy()
		end
	else
		btn.Text = "Invalid Key"
		btn.BackgroundColor3 = THEME.danger
		task.delay(1, function()
			btn.Text = "Verify Key"
			btn.BackgroundColor3 = THEME.item
		end)
	end
end)

