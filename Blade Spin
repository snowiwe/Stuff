CreateSection(SettingsTab, "VISUALS")

-- ESP LOGIC
local function CreateESP(targetPlayer)
	if not targetPlayer.Character then return end
	local char = targetPlayer.Character
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then return end

	-- 1. Highlight
	local hl = Instance.new("Highlight")
	hl.Name = "BladeESP_HL"
	hl.FillColor = Color3.fromRGB(255, 0, 0)
	hl.FillTransparency = 0.5
	hl.OutlineColor = Color3.fromRGB(255, 255, 255)
	hl.OutlineTransparency = 0
	hl.Parent = char

	-- 2. Text (Name + Distance)
	local bb = Instance.new("BillboardGui")
	bb.Name = "BladeESP_BB"
	bb.Adornee = root
	bb.Size = UDim2.new(0, 200, 0, 50)
	bb.StudsOffset = Vector3.new(0, 3, 0)
	bb.AlwaysOnTop = true
	bb.Parent = char

	local txt = Instance.new("TextLabel")
	txt.Size = UDim2.new(1, 0, 1, 0)
	txt.BackgroundTransparency = 1
	txt.TextColor3 = Color3.fromRGB(255, 255, 255)
	txt.TextStrokeTransparency = 0
	txt.Font = Enum.Font.SourceSansBold
	txt.TextSize = 14
	txt.Text = targetPlayer.Name
	txt.Parent = bb

	-- Update Loop for Text Distance
	task.spawn(function()
		while char.Parent and bb.Parent do
			if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
				local dist = (player.Character.HumanoidRootPart.Position - root.Position).Magnitude
				txt.Text = string.format("%s\n[%.0f m]", targetPlayer.Name, dist)
			end
			task.wait(0.5)
		end
	end)

	-- 3. Tracer Lines (Beam)
	if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
		local att0 = Instance.new("Attachment", player.Character.HumanoidRootPart)
		local att1 = Instance.new("Attachment", root)
		
		local beam = Instance.new("Beam")
		beam.Name = "BladeESP_Beam"
		beam.Attachment0 = att0
		beam.Attachment1 = att1
		beam.FaceCamera = true
		beam.Width0 = 0.1
		beam.Width1 = 0.1
		beam.Color = ColorSequence.new(Color3.fromRGB(255, 0, 0))
		beam.Parent = char
	end
end

local function ClearESP()
	for _, v in pairs(Players:GetPlayers()) do
		if v.Character then
			for _, c in pairs(v.Character:GetChildren()) do
				if c.Name:find("BladeESP") then c:Destroy() end
			end
		end
	end
end

CreateToggle(SettingsTab, "ESP (Lines + Dist)", "See players through walls", function(val)
	EspEnabled = val
	if val then
		-- Add existing
		for _, p in pairs(Players:GetPlayers()) do
			if p ~= player then CreateESP(p) end
		end
		-- Add new
		Players.PlayerAdded:Connect(function(p)
			p.CharacterAdded:Connect(function()
				if EspEnabled then 
					task.wait(1)
					CreateESP(p) 
				end
			end)
		end)
	else
		ClearESP()
	end
end)

CreateToggle(SettingsTab, "Low Performance", "Removes shadows/effects", function(val)
	Lighting.GlobalShadows = not val
	Lighting.FogEnd = val and 9e9 or 100000
end)

