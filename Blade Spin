	local ToggleBtn = Instance.new("TextButton")
	ToggleBtn.Size = UDim2.new(1, 0, 0, 50)
	ToggleBtn.BackgroundTransparency = 1
	ToggleBtn.Text = ""
	ToggleBtn.Parent = Frame

	local TitleL = Instance.new("TextLabel")
	TitleL.Text = "Select Target..."
	TitleL.Size = UDim2.new(1, -40, 1, 0)
	TitleL.Position = UDim2.new(0, 12, 0, 0)
	TitleL.BackgroundTransparency = 1
	TitleL.TextColor3 = THEME.text
	TitleL.Font = Enum.Font.SourceSansBold
	TitleL.TextSize = 14
	TitleL.TextXAlignment = Enum.TextXAlignment.Left
	TitleL.Parent = ToggleBtn

	local Arrow = Instance.new("ImageLabel")
	Arrow.Image = "rbxassetid://6031091004"
	Arrow.Size = UDim2.new(0, 20, 0, 20)
	Arrow.Position = UDim2.new(1, -30, 0.5, -10)
	Arrow.BackgroundTransparency = 1
	Arrow.ImageColor3 = THEME.subtext
	Arrow.Parent = ToggleBtn

	local ListContainer = Instance.new("ScrollingFrame")
	ListContainer.Size = UDim2.new(1, 0, 0, 0)
	ListContainer.Position = UDim2.new(0, 0, 0, 50)
	ListContainer.BackgroundTransparency = 1
	ListContainer.Parent = Frame
	ListContainer.ScrollBarThickness = 2
	local lLayout = Instance.new("UIListLayout"); lLayout.Parent = ListContainer; lLayout.Padding = UDim.new(0,2)

	local isOpen = false
	local function UpdateList()
		for _, v in pairs(ListContainer:GetChildren()) do if v:IsA("TextButton") then v:Destroy() end end
		local count = 0
		for _, p in pairs(Players:GetPlayers()) do
			if p ~= player then
				count = count + 1
				local btn = Instance.new("TextButton")
				btn.Size = UDim2.new(1, -10, 0, 30)
				btn.BackgroundColor3 = THEME.banner
				btn.Text = p.Name
				btn.TextColor3 = THEME.text
				btn.Font = Enum.Font.SourceSans
				btn.TextSize = 14
				btn.Parent = ListContainer
				Instance.new("UICorner", btn).CornerRadius = UDim.new(0,6)
				
				btn.MouseButton1Click:Connect(function()
					callback(p.Name)
					TitleL.Text = "Target: " .. p.Name
					isOpen = false
					doTween(Frame, {Size = UDim2.new(1, -6, 0, 50)})
					doTween(Arrow, {Rotation = 0})
				end)
			end
		end
		ListContainer.CanvasSize = UDim2.new(0, 0, 0, count * 32)
		return count
	end

	ToggleBtn.MouseButton1Click:Connect(function()
		isOpen = not isOpen
		local count = UpdateList()
		doTween(Arrow, {Rotation = isOpen and 180 or 0})
		
		if isOpen then
			local h = math.min(count * 32, 150)
			doTween(ListContainer, {Size = UDim2.new(1, 0, 0, h)})
			doTween(Frame, {Size = UDim2.new(1, -6, 0, 50 + h + 5)})
		else
			doTween(ListContainer, {Size = UDim2.new(1, 0, 0, 0)})
			doTween(Frame, {Size = UDim2.new(1, -6, 0, 50)})
		end
	end)
end

