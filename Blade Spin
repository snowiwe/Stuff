-- // 6. HELPER FUNCTIONS //
local function doTween(obj, props)
	TweenService:Create(obj, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

local function GetRemote(name)
	local holder = ReplicatedStorage:WaitForChild("ReplicatedStorageHolders", 2)
	local events = holder and holder:WaitForChild("Events", 2)
	return events and events:WaitForChild(name, 2)
end

