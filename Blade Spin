CreateSection(SettingsTab, "VISUALS")

-- Basic ESP Implementation
local function AddESP(p)
	if p == player or not p.Character then return end
	
	-- Cleanup old
	if EspCache[p] then EspCache[p]:Destroy(); EspCache[p] = nil end

	local char = p.Character
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then return end

	local holder = Instance.new("Folder")
	holder.Name = p.Name .. "_ESP"
	holder.Parent = char

	-- Highlight
	local hl = Instance.new("Highlight")
	hl.FillColor = THEME.danger
	hl.FillTransparency = 0.5
	hl.OutlineColor = THEME.text
	hl.OutlineTransparency = 0
	hl.Parent = holder

	-- Distance Text
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.new(0, 200, 0, 50)
	bb.StudsOffset = Vector3.new(0, 3, 0)
	bb.AlwaysOnTop = true
	bb.Parent = holder
	bb.Adornee = root

	local txt = Instance.new("TextLabel")
	txt.Size = UDim2.fromScale(1,1)
	txt.BackgroundTransparency = 1
	txt.TextColor3 = THEME.text
	txt.TextStrokeTransparency = 0
	txt.Font = Enum.Font.SourceSansBold
	txt.TextSize = 14
	txt.Text = p.Name
	txt.Parent = bb

	-- Tracer Line
	local attach1 = Instance.new("Attachment", root)
	local beam = Instance.new("Beam")
	beam.Attachment0 = nil -- Will update in loop
	beam.Attachment1 = attach1
	beam.Color = ColorSequence.new(THEME.danger)
	beam.Width0 = 0.1
	beam.Width1 = 0.1
	beam.FaceCamera = true
	beam.Enabled = false
	beam.Parent = holder

	EspCache[p] = holder

	-- Update Loop
	task.spawn(function()
		while EspEnabled and holder.Parent do
			if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
				local dist = (player.Character.HumanoidRootPart.Position - root.Position).Magnitude
				txt.Text = string.format("%s\n[%.0f m]", p.Name, dist)
				
				-- Update Tracer
				local myRoot = player.Character.HumanoidRootPart
				if not myRoot:FindFirstChild("TracerAttach") then
					local a = Instance.new("Attachment", myRoot)
					a.Name = "TracerAttach"
				end
				beam.Attachment0 = myRoot:FindFirstChild("TracerAttach")
				beam.Enabled = true
			else
				beam.Enabled = false
			end
			task.wait(0.1)
		end
		holder:Destroy()
	end)
end

CreateToggle(SettingsTab, "ESP (Lines + Dist)", "See players through walls", function(val)
	EspEnabled = val
	if val then
		for _, p in pairs(Players:GetPlayers()) do AddESP(p) end
		Players.PlayerAdded:Connect(function(p)
			p.CharacterAdded:Connect(function() 
				if EspEnabled then task.wait(1); AddESP(p) end 
			end)
		end)
	else
		for _, v in pairs(EspCache) do v:Destroy() end
		EspCache = {}
	end
end)

CreateToggle(SettingsTab, "Low Performance", "Removes shadows/effects", function(val)
