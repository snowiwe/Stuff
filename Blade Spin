local visible = false -- UI Starts Hidden

local function ToggleUI()
	visible = not visible
	if visible then
		MainFrame.Visible = true
		Minimized = false
		MainFrame.Size = UDim2.new(0,0,0,0) -- Reset
		TweenService:Create(MainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = OPEN_SIZE}):Play()
		doTween(MinBtn, {Rotation = 180})
		ContentArea.Visible = true
	else
		TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In), {Size = UDim2.new(0,0,0,0)}):Play()
		task.delay(0.3, function() MainFrame.Visible = false end)
	end
end

