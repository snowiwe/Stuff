-- // 5. REMOTE HANDLER //
local function GetEvent(name)
	local Holders = ReplicatedStorage:WaitForChild("ReplicatedStorageHolders", 2)
	if not Holders then return nil end

	local Events = Holders:WaitForChild("Events", 2)
	if not Events then return nil end

	return Events:WaitForChild(name, 2)
end

local function TriggerUpgrade(statName, success, fail)
	local r = GetEvent("UpgradeStat")
	if r then
		local args = { statName }
		r:FireServer(unpack(args))
		if success then success() end
	else
		if fail then fail() end
	end
end

