local visible = false
local function ToggleUI()
	visible = not visible
	if visible then
		MainFrame.Visible = true; Minimized = false; ContentArea.Visible = true
		MainFrame.Size = UDim2.new(0,0,0,0)
		doTween(MainFrame, {Size = OPEN_SIZE}, 0.4, Enum.EasingStyle.Back)
		doTween(MinBtn, {Rotation = 180})
	else
		doTween(MainFrame, {Size = UDim2.new(0,0,0,0)}, 0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		task.delay(0.3, function() MainFrame.Visible = false end)
	end
end
