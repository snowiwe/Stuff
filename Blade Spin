-- Tracers with Cleanup
local function UpdateTracers()
	if not EspTracersEnabled then
		for _, v in pairs(TracerCache) do 
			if v.Beam then v.Beam:Destroy() end
			if v.A0 then v.A0:Destroy() end
			if v.A1 then v.A1:Destroy() end
		end
		TracerCache = {}
		return
	end

	for _, p in pairs(Players:GetPlayers()) do
		if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
			local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if myRoot then
				if not TracerCache[p] then
					local att0 = Instance.new("Attachment", myRoot)
					local att1 = Instance.new("Attachment", p.Character.HumanoidRootPart)
					local beam = Instance.new("Beam", myRoot)
					beam.Attachment0 = att0
					beam.Attachment1 = att1
					beam.Color = ColorSequence.new(Color3.fromRGB(255, 50, 50)) 
					beam.FaceCamera = true
					beam.Width0 = 0.1
					beam.Width1 = 0.1
					TracerCache[p] = {Beam = beam, A0 = att0, A1 = att1}
				end
			end
		else
			if TracerCache[p] then
				if TracerCache[p].Beam then TracerCache[p].Beam:Destroy() end
				TracerCache[p] = nil
			end
		end
	end
end

CreateToggle(SettingsTab, "Player Tracers", "Show lines to players", function(val)
	EspTracersEnabled = val
	if val then
		RunService:BindToRenderStep("EspTracers", Enum.RenderPriority.Camera.Value, UpdateTracers)
	else
		RunService:UnbindFromRenderStep("EspTracers")
		UpdateTracers() -- Cleanup
	end
end)

