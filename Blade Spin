Instance.new("UICorner", ToggleIcon).CornerRadius = UDim.new(0, 12)
Instance.new("UIStroke", ToggleIcon).Color = THEME.stroke

local visible = false
local function ToggleUI()
	visible = not visible
	if visible then
		MainFrame.Visible = true
		doTween(MainFrame, {Size = OPEN_SIZE})
		doTween(MinBtn, {Rotation = 180})
	else
		doTween(MainFrame, {Size = CLOSED_SIZE})
		doTween(MinBtn, {Rotation = 0})
		task.delay(0.3, function() if not visible then MainFrame.Visible = false end end)
	end
end

ToggleIcon.MouseButton1Click:Connect(ToggleUI)
MinBtn.MouseButton1Click:Connect(ToggleUI)
UserInputService.InputBegan:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.RightControl then ToggleUI() end
end)

-- Mobile Button Drag
local btnDragging, btnDragStart, btnStartPos
ToggleIcon.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Touch then
		btnDragging = true
		btnDragStart = input.Position
		btnStartPos = ToggleIcon.Position
		input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then btnDragging = false end end)
	end
end)
ToggleIcon.InputChanged:Connect(function(input)
	if btnDragging and input.UserInputType == Enum.UserInputType.Touch then
		local delta = input.Position - btnDragStart
		ToggleIcon.Position = UDim2.new(btnStartPos.X.Scale, btnStartPos.X.Offset + delta.X, btnStartPos.Y.Scale, btnStartPos.Y.Offset + delta.Y)
	end
end)

