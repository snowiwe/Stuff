-- Tracers Logic
local function UpdateTracers()
	if not EspTracersEnabled then
		for _, v in pairs(TracerCache) do if v.Beam then v.Beam:Destroy() end end
		TracerCache = {}
		return
	end
	local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not myRoot then return end 
	for _, p in pairs(Players:GetPlayers()) do
		if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
			local root = p.Character.HumanoidRootPart
			if (root.Position - myRoot.Position).Magnitude <= MAX_TRACER_DIST then
				if not TracerCache[p] then
					local att0 = Instance.new("Attachment", myRoot)
					local att1 = Instance.new("Attachment", root)
					local beam = Instance.new("Beam", myRoot)
					beam.Attachment0 = att0; beam.Attachment1 = att1; beam.FaceCamera = true; beam.Width0 = 0.2; beam.Width1 = 0.2
					beam.Color = ColorSequence.new(THEME.accent)
					TracerCache[p] = {Beam = beam}
				end
			else
				if TracerCache[p] then TracerCache[p].Beam:Destroy(); TracerCache[p] = nil end
			end
		end
	end
end

CreateToggle(SettingsTab, "Player Tracers", "Show lines to players", function(val)
	EspTracersEnabled = val
	if val then RunService:BindToRenderStep("LumaTracers", Enum.RenderPriority.Camera.Value, UpdateTracers)
	else RunService:UnbindFromRenderStep("LumaTracers"); UpdateTracers() end
end)

