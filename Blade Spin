-- Mobile Drag
local btnDragging, btnDragStart, btnStartPos
ToggleIcon.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Touch then
		btnDragging = true; btnDragStart = input.Position; btnStartPos = ToggleIcon.Position
		input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then btnDragging = false end end)
	end
end)
ToggleIcon.InputChanged:Connect(function(input)
	if btnDragging and input.UserInputType == Enum.UserInputType.Touch then
		local delta = input.Position - btnDragStart
		ToggleIcon.Position = UDim2.new(btnStartPos.X.Scale, btnStartPos.X.Offset + delta.X, btnStartPos.Y.Scale, btnStartPos.Y.Offset + delta.Y)
	end
end)

