	DescL.TextColor3 = THEME.subtext
	DescL.Font = DESC_FONT
	DescL.TextSize = 13
	DescL.TextXAlignment = Enum.TextXAlignment.Left
	DescL.Parent = Frame

	local Switch = Instance.new("Frame", Frame)
	Switch.Size = UDim2.new(0, 44, 0, 24)
	Switch.Position = UDim2.new(1, -15, 0.5, 0)
	Switch.AnchorPoint = Vector2.new(1, 0.5)
	Switch.BackgroundColor3 = THEME.switchOff
	rounded(Switch, 12)

	local Knob = Instance.new("Frame", Switch)
	Knob.Size = UDim2.new(0, 20, 0, 20)
	Knob.Position = UDim2.new(0, 2, 0.5, 0)
	Knob.AnchorPoint = Vector2.new(0, 0.5)
	Knob.BackgroundColor3 = THEME.text
	rounded(Knob, 10)

	local state = false
	-- Sync states
	if title == "Hide Profile Info" then state = HideProfileEnabled end
	if title == "Draggable UI" then state = DraggableEnabled end

	if state then 
		Switch.BackgroundColor3 = THEME.success
		Knob.Position = UDim2.new(1, -22, 0.5, 0)
		s.Color = THEME.success
	end

	Frame.MouseButton1Click:Connect(function()
		state = not state
		callback(state)
		if state then
			doTween(Switch, {BackgroundColor3 = THEME.success})
			doTween(Knob, {Position = UDim2.new(1, -22, 0.5, 0)})
			doTween(s, {Color = THEME.success})
		else
			doTween(Switch, {BackgroundColor3 = THEME.switchOff})
			doTween(Knob, {Position = UDim2.new(0, 2, 0.5, 0)})
			doTween(s, {Color = THEME.stroke})
		end
	end)
end

local function CreateButton(parent, title, desc, callback)
	local Btn = Instance.new("TextButton")
