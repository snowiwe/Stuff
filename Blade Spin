	DescL.BackgroundTransparency = 1
	DescL.TextColor3 = THEME.subtext
	DescL.Font = DESC_FONT
	DescL.TextSize = 13
	DescL.TextXAlignment = Enum.TextXAlignment.Left
	DescL.Parent = Btn

	local function success()
		doTween(s, {Color = THEME.success}); doTween(TitleL, {TextColor3 = THEME.success})
		task.delay(0.5, function() doTween(s, {Color = THEME.stroke}); doTween(TitleL, {TextColor3 = THEME.text}) end)
	end
	local function fail()
		doTween(s, {Color = THEME.danger}); doTween(TitleL, {TextColor3 = THEME.danger})
		task.delay(0.5, function() doTween(s, {Color = THEME.stroke}); doTween(TitleL, {TextColor3 = THEME.text}) end)
	end

	Btn.MouseButton1Click:Connect(function()
		doTween(Btn, {Size = UDim2.new(1, -18, 0, 48)}, 0.1)
		task.delay(0.1, function() doTween(Btn, {Size = UDim2.new(1, -12, 0, 50)}, 0.1) end)
		callback(success, fail, TitleL)
	end)
end

