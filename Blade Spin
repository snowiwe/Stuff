local function doTween(obj, props)
	TweenService:Create(obj, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

local function GetRemote(name)
	local holder = ReplicatedStorage:FindFirstChild("ReplicatedStorageHolders")
	local events = holder and holder:FindFirstChild("Events")
	return events and events:FindFirstChild(name)
end

