	pPad.PaddingBottom = UDim.new(0,10)

	Pages[name] = {Btn = TabBtn, Page = Page, Stroke = tStroke}

	TabBtn.MouseButton1Click:Connect(function()
		for n, data in pairs(Pages) do
			if n == name then
				data.Page.Visible = true
				data.Page.CanvasPosition = Vector2.new(0, 0)
