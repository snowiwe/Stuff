local iconDragging, iconDragStart, iconStartPos = false, nil, nil
MobileToggle.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        iconDragging = false; iconDragStart = input.Position; iconStartPos = MobileToggle.Position
        local moveConn, endConn
        moveConn = UserInputService.InputChanged:Connect(function(moveInput)
            if (moveInput.UserInputType == Enum.UserInputType.MouseMovement or moveInput.UserInputType == Enum.UserInputType.Touch) and iconDragStart then
                local delta = moveInput.Position - iconDragStart
                if delta.Magnitude > 6 then
                    iconDragging = true
                    MobileToggle.Position = clampPosition(UDim2.new(iconStartPos.X.Scale, iconStartPos.X.Offset + delta.X, iconStartPos.Y.Scale, iconStartPos.Y.Offset + delta.Y), MobileToggle)
                end
            end
        end)
        endConn = UserInputService.InputEnded:Connect(function(endInput)
            if endInput.UserInputType == Enum.UserInputType.MouseButton1 or endInput.UserInputType == Enum.UserInputType.Touch then
                if moveConn then moveConn:Disconnect() end
                if endConn then endConn:Disconnect() end
                if not iconDragging then toggleMenu() end
            end
        end)
    end
end)

UserInputService.InputBegan:Connect(function(inp, gpe)
    if not gpe and (inp.KeyCode == Enum.KeyCode.RightControl or inp.KeyCode == Enum.KeyCode.P) then
        toggleMenu()
    end
end)

RunService.Heartbeat:Connect(function()
    if SensorInfoActive then
        userRow.Text = "Account: [HIDDEN / SECURE]"
        placeRow.Text = "Place ID: [HIDDEN]"
        distRow.Text = "Radar Range: [MASKED]"
    else
        userRow.Text = "Account: @" .. LocalPlayer.Name
        placeRow.Text = "Place: " .. tostring(game.PlaceId)
        distRow.Text = "Max Range: " .. espDistance .. "m"
    end
    uptimeRow.Text = "Session: " .. formatUptime(os.time() - StartEpoch)
end)

openMenu()
Notify("Lumacore", "Survive The Apocalypse Suite Loaded", C.Accent)
print("[Lumacore] Survive The Apocalypse Suite active.")
