local function clampPosition(rawPos, obj)
    local cam = Workspace.CurrentCamera
    local vSize = (cam and cam.ViewportSize) or Vector2.new(800, 600)
    local oWidth = (obj.AbsoluteSize.X > 0 and obj.AbsoluteSize.X) or 580
    local oHeight = (obj.AbsoluteSize.Y > 0 and obj.AbsoluteSize.Y) or 345
    local absX = (rawPos.X.Scale * vSize.X) + rawPos.X.Offset
    local absY = (rawPos.Y.Scale * vSize.Y) + rawPos.Y.Offset
    return UDim2.new(0, math.clamp(absX, obj.AnchorPoint.X * oWidth + 6, vSize.X - ((1 - obj.AnchorPoint.X) * oWidth) - 6),
                     0, math.clamp(absY, obj.AnchorPoint.Y * oHeight + 6, vSize.Y - ((1 - obj.AnchorPoint.Y) * oHeight) - 6))
end

local dragging, dragStart, startPos = false, nil, nil
Header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true; dragStart = input.Position; startPos = Card.Position
        local moveConn, endConn
        moveConn = UserInputService.InputChanged:Connect(function(moveInput)
            if (moveInput.UserInputType == Enum.UserInputType.MouseMovement or moveInput.UserInputType == Enum.UserInputType.Touch) and dragging then
                local delta = moveInput.Position - dragStart
                Card.Position = clampPosition(UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y), Card)
            end
        end)
        endConn = UserInputService.InputEnded:Connect(function(endInput)
            if endInput.UserInputType == Enum.UserInputType.MouseButton1 or endInput.UserInputType == Enum.UserInputType.Touch then
                dragging = false
                if moveConn then moveConn:Disconnect() end
                if endConn then endConn:Disconnect() end
            end
        end)
    end
end)

